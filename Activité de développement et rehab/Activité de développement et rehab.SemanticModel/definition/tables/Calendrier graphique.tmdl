	partition 'Calendrier graphique' = calculated
		mode: import
		source =
				
				VAR _AnneeEnCours = YEAR(TODAY())
				VAR _DateDebut = DATE(2015, 1, 1)
				VAR _DateFin = DATE(_AnneeEnCours, 12, 31)
				RETURN
				ADDCOLUMNS (
				    CALENDAR(_DateDebut, _DateFin),
				    "Année", YEAR([Date]),
				    "Mois Num", MONTH([Date]),
				    "Mois", FORMAT([Date], "MMMM"),
				    "Mois Court", FORMAT([Date], "MMM"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Semaine Num", WEEKNUM([Date], 2),
				    "Jour Semaine Num", WEEKDAY([Date], 2),
				    "Jour Semaine", FORMAT([Date], "dddd"),
				    "Année Mois Num", YEAR([Date]) * 100 + MONTH([Date]),
				    "Année Mois", FORMAT([Date], "mmm yyyy")
				)

	annotation PBI_Id = 9bc3e9e5ad214354b10333952e958275

