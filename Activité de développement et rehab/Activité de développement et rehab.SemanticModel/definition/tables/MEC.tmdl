	partition MEC = m
		mode: import
		source =
				let
				    // 1. Connexion au site SharePoint Source
				    Source = SharePoint.Files("https://shlmrfr.sharepoint.com/sites/productionneuve/", [ApiVersion = 15]),
				
				    // 2. Filtrer les fichiers Excel
				    #"Lignes filtrées" = Table.SelectRows(Source, each ([Extension] = ".xls" or [Extension] = ".xlsm" or [Extension] = ".xlsx")),
				
				    // 3. Trier par date de modif décroissante
				    #"Lignes triées" = Table.Sort(#"Lignes filtrées", {{"Date modified", Order.Descending}}),
				
				    // 4. Filtrer uniquement TDB DES INDICATEURS PRODUCTION NEUVE.xlsx
				    #"Lignes filtrées1" = Table.SelectRows(#"Lignes triées", each ([Name] = "TDB DES INDICATEURS PRODUCTION NEUVE.xlsx")),
				
				    // 5. Filtrer les fichiers masqués
				    #"Fichiers masqués filtrés1" = Table.SelectRows(#"Lignes filtrées1", each [Attributes]?[Hidden]? <> true),
				
				    // 6. Prendre la dernière version
				    DerniereVersion = Table.FirstN(#"Fichiers masqués filtrés1", 1),
				
				    // 7. Charger le fichier Excel et repérer l'onglet "PROGR"
				    ExcelFile = Excel.Workbook(DerniereVersion{0}[Content], null, true),
				    MEC = Table.SelectRows(ExcelFile, each [Name] = "MEC"){0}[Data],
				
				    // 8. Supprimer les 3 premières lignes (tableau commence ligne 4)
				    #"Premières lignes supprimées" = Table.Skip(MEC, 3),
				
				    // 9. Promouvoir les en-têtes
				    #"En-têtes promus" = Table.PromoteHeaders(#"Premières lignes supprimées", [PromoteAllScalars=true]),
				
				    // 10. Typage générique
				    #"Type modifié" = Table.TransformColumnTypes(
				        #"En-têtes promus",
				        List.Transform(Table.ColumnNames(#"En-têtes promus"), each {_, type any})
				    ),
				    #"Lignes filtrées2" = Table.SelectRows(#"Type modifié", each ([LBU] <> null and [LBU] <> 0 and [LBU] <> "" and [LBU] <> "XXXX")),
				    #"Type modifié1" = Table.TransformColumnTypes(#"Lignes filtrées2",{{"LBU", type date}}),
				    #"Année extraite" = Table.TransformColumns(#"Type modifié1",{{"LBU", Date.Year, Int64.Type}}),
				    #"Type modifié2" = Table.TransformColumnTypes(#"Année extraite",{{"DATE OS/ACTE PREV", type date}}),
				    #"Lignes filtrées3" = Table.SelectRows(#"Type modifié2", each true),
				    #"Type modifié3" = Table.TransformColumnTypes(#"Lignes filtrées3",{{"NB LOGTS", Int64.Type}, {"DATE OS/ACTE REELLE", type date}}),
				    #"Duplication de la colonne" = Table.DuplicateColumn(#"Type modifié3", "DATE OS/ACTE PREV", "DATE OS/ACTE PREV - Copier"),
				    #"Colonnes renommées" = Table.RenameColumns(#"Duplication de la colonne",{{"DATE OS/ACTE PREV - Copier", "Prévisonnel graph"}}),
				    #"Duplication de la colonne1" = Table.DuplicateColumn(#"Colonnes renommées", "DATE OS/ACTE REELLE", "DATE OS/ACTE REELLE - Copier"),
				    #"Colonnes renommées1" = Table.RenameColumns(#"Duplication de la colonne1",{{"DATE OS/ACTE REELLE - Copier", "Réel graph"}})
				in
				    #"Colonnes renommées1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

