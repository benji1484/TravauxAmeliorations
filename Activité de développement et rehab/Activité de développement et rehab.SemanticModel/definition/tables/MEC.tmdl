	column Commune_Villes =
			
			SWITCH(
			    TRUE(),
			    'MEC'[Commune] = "BRAS PANON", "Bras-Panon",
			    'MEC'[Commune] = "CILAOS", "Cilaos",
			    'MEC'[Commune] = "ENTRE DEUX", "Entre-Deux",
			    'MEC'[Commune] = "ETANG SALE", "L'Étang-Salé",
			    'MEC'[Commune] = "LA POSSESSION", "La Possession",
			    'MEC'[Commune] = "LE PORT", "Le Port",
			    'MEC'[Commune] = "LE TAMPON", "Le Tampon",
			    'MEC'[Commune] = "LES AVIRONS", "Les Avirons",
			    'MEC'[Commune] = "PETITE ILE", "Petite-Île",
			    'MEC'[Commune] = "PLAINE DES PALMISTES", "Plaine des palmistes",
			    'MEC'[Commune] = "SAINT ANDRE", "Saint-André",
			    'MEC'[Commune] = "SAINT BENOIT", "Saint-Benoît",
			    'MEC'[Commune] = "SAINT DENIS", "Saint-Denis",
			    'MEC'[Commune] = "SAINT JOSEPH", "Saint-Joseph",
			    'MEC'[Commune] = "SAINT LEU", "Saint-Leu",
			    'MEC'[Commune] = "SAINT LOUIS", "Saint-Louis",
			    'MEC'[Commune] = "SAINT PAUL", "Saint-Paul",
			    'MEC'[Commune] = "SAINT PHILIPPE", "Saint-Philippe",
			    'MEC'[Commune] = "SAINT PIERRE", "Saint-Pierre",
			    'MEC'[Commune] = "SAINTE MARIE", "Sainte-Marie",
			    'MEC'[Commune] = "SAINTE ROSE", "Sainte-Rose",
			    'MEC'[Commune] = "SAINTE SUZANNE", "Sainte-Suzanne",
			    'MEC'[Commune] = "SALAZIE", "Salazie",
			    'MEC'[Commune] = "TROIS BASSINS", "Trois-Bassins",
