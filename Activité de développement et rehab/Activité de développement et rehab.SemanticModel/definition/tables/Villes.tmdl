	partition Villes = m
		mode: import
		source =
				let
				    // 1. Connexion au dossier SharePoint
				    Source = SharePoint.Files("https://shlmrfr.sharepoint.com/sites/EnquteReportingexterne-TableaudebordCODIR", [ApiVersion = 15]),
				
				    // 2. Filtrer le fichier Correspondance Géo.xlsx
				    FichierGeo = Table.SelectRows(Source, each [Name] = "Correspondance Géo.xlsx"),
				
				    // 3. Trier pour garder la version la plus récente
				    TrierParDate = Table.Sort(FichierGeo, {{"Date modified", Order.Descending}}),
				    DerniereVersion = Table.FirstN(TrierParDate, 1),
				
				    // 4. Étendre les attributs
				    #"Attributes développé" = Table.ExpandRecordColumn(DerniereVersion, "Attributes", {"Size", "Content Type", "Kind"}, {"Attributes.Size", "Attributes.Content Type", "Attributes.Kind"}),
				
				    // 5. Supprimer les fichiers masqués si besoin
				    #"Fichiers masqués filtrés1" = Table.SelectRows(#"Attributes développé", each [Attributes]?[Hidden]? <> true),
				
				    // 6. Charger le fichier Excel
				    ExcelFile = Excel.Workbook(#"Fichiers masqués filtrés1"{0}[Content], null, true),
				
				    // 7. Cibler la feuille "Feuil1"
				    Feuil1_Sheet = ExcelFile{[Item="Feuil1", Kind="Sheet"]}[Data],
				
				    // 8. Typage initial pour stabiliser la promotion
				    #"Type modifié" = Table.TransformColumnTypes(Feuil1_Sheet,{{"Column1", type text}, {"Column2", type text}, {"Column3", type text}}),
				
				    // 9. Promouvoir les en-têtes
				    #"En-têtes promus" = Table.PromoteHeaders(#"Type modifié", [PromoteAllScalars=true]),
				
				    // 10. Typage final
				    #"Type modifié1" = Table.TransformColumnTypes(#"En-têtes promus",{
				        {"Commune", type text},
				        {"Latitude", type text},
				        {"Longitude", type text}
				    })
				in
				    #"Type modifié1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

