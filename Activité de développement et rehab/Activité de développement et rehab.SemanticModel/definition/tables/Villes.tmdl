	column EPCI = ```
			
			SWITCH(TRUE(),
			    'Villes'[Commune] IN {"St-Denis", "Sainte-Marie", "Ste-Marie", "Ste-Suzanne", "Sainte-Suzanne", "Saint-Denis"}, "CINOR",
			    'Villes'[Commune] IN {"St-André", "Saint-André", "Bras-Panon", "St-Benoît", "Saint-Benoît", "Plaine des palmistes", "Salazie", "La Plaine-des-Palmistes"}, "CIREST",
			    'Villes'[Commune] IN {"Le Port", "La Possession", "St-Paul", "Saint-Paul", "St-Leu", "Saint-Leu", "Trois-Bassins"}, "TO",
			    'Villes'[Commune] IN {"Le Tampon", "St-Joseph", "Saint-Joseph", "Entre-Deux", "L'Étang-Salé", "L'étang-Salé", "Cilaos"}, "CASUD",
			    'Villes'[Commune] IN {"St-Pierre", "Saint-Louis", "Les Avirons", "Petite-Île", "St-Louis", "Saint-Pierre"}, "CIVIS",
			    "Non défini"
			)
			
			```
