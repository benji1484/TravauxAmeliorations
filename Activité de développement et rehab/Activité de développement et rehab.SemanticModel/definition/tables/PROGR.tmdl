	column Statut =
			
			VAR Depot = TRIM('PROGR'[DATE DEPOT AGREMENT] & "")
			VAR Obtention = TRIM('PROGR'[DATE OBT AGREMENT] & "")
			RETURN
			SWITCH(
			    TRUE(),
			    Depot = "", "Non déposés",
			    Obtention = "" || Obtention IN {"x","ci","Q"}, "Agréments en cours",
			    "Agréments obtenus"
			)
		lineageTag: a4e5d041-f1ce-4f18-940f-ac21f47b61bd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Statut_détaillé = 'PROGR'[PDT] &" : " & IF(len('PROGR'[DATE DEPOT AGREMENT]) = 0, "Non déposés", if(len('PROGR'[DATE DEPOT AGREMENT]) > 0 && LEN('PROGR'[DATE OBT AGREMENT]) > 0, "Agréments obtenus", "Agréments en cours"))
		lineageTag: d21c7aa2-9870-4d00-be80-2ff105a3bb1e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

