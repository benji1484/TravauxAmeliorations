	column 'Réception agrément date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: a3835973-d2b4-4024-8a2c-2b15b5dac742
		summarizeBy: none
		sourceColumn: Réception agrément date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition PROGR = m
		mode: import
		source =
				let
				    // 1. Connexion au site SharePoint Source
				    Source = SharePoint.Files("https://shlmrfr.sharepoint.com/sites/productionneuve/", [ApiVersion = 15]),
				
				    // 2. Filtrer les fichiers Excel
				    #"Lignes filtrées" = Table.SelectRows(Source, each ([Extension] = ".xls" or [Extension] = ".xlsm" or [Extension] = ".xlsx")),
				
				    // 3. Trier par date de modif décroissante
				    #"Lignes triées" = Table.Sort(#"Lignes filtrées", {{"Date modified", Order.Descending}}),
				
				    // 4. Filtrer uniquement TDB DES INDICATEURS PRODUCTION NEUVE.xlsx
				    #"Lignes filtrées1" = Table.SelectRows(#"Lignes triées", each ([Name] = "TDB DES INDICATEURS PRODUCTION NEUVE.xlsx")),
				
				    // 5. Filtrer les fichiers masqués
				    #"Fichiers masqués filtrés1" = Table.SelectRows(#"Lignes filtrées1", each [Attributes]?[Hidden]? <> true),
				
				    // 6. Prendre la dernière version
				    DerniereVersion = Table.FirstN(#"Fichiers masqués filtrés1", 1),
				
				    // 7. Charger le fichier Excel et repérer l'onglet "PROGR"
				    ExcelFile = Excel.Workbook(DerniereVersion{0}[Content], null, true),
				    Prog = Table.SelectRows(ExcelFile, each [Name] = "PROGR"){0}[Data],
				
				    // 8. Supprimer les 3 premières lignes
				    #"Premières lignes supprimées" = Table.Skip(Prog, 3),
				
				    // 9. Promouvoir les en-têtes
				    #"En-têtes promus" = Table.PromoteHeaders(#"Premières lignes supprimées", [PromoteAllScalars=true]),
				
				    // 10. Typage générique
				    #"Type modifié" = Table.TransformColumnTypes(
				        #"En-têtes promus",
				        List.Transform(Table.ColumnNames(#"En-têtes promus"), each {_, type any})
				    ),
				
				    // 11. Filtrer les lignes avec LBU non null et non "XXXX"
				    #"Lignes filtrées2" = Table.SelectRows(#"Type modifié", each ([LBU] <> null and [LBU] <> "XXXX")),
				
				    // 12. Typer NB LOGTS et LBU
				    #"Type modifié1" = Table.TransformColumnTypes(
				        #"Lignes filtrées2",
				        {{"NB LOGTS", Int64.Type}, {"LBU", type date}}
				    ),
				
				    // 13. Transformer LBU en année, sans filtrer sur 2026
				    #"Année extraite" = Table.TransformColumns(
				        #"Type modifié1",
				        {{"LBU", Date.Year, Int64.Type}}
				    ),
				
				    // 14. Renommer PRODUIT en PDT
				    #"Colonnes renommées" = Table.RenameColumns(
				        #"Année extraite",
				        {{"PRODUIT", "PDT"}}
				    ),
				
				    // 15. Typer LBU EN € et FONDS PROPRES
				    #"Type modifié2" = Table.TransformColumnTypes(
				        #"Colonnes renommées",
				        {{"LBU EN €", Int64.Type}, {"FONDS PROPRES", Int64.Type}}
				    ),
				
				    // 16. Dupliquer DATE DEPOT AGREMENT pour créer Dépot agrément graph
				    #"Duplication de la colonne" = Table.DuplicateColumn(
				        #"Type modifié2",
				        "DATE DEPOT AGREMENT",
				        "DATE DEPOT AGREMENT - Copier"
				    ),
				
				    #"Colonnes renommées1" = Table.RenameColumns(
				        #"Duplication de la colonne",
				        {{"DATE DEPOT AGREMENT - Copier", "Dépot agrément graph"}}
				    ),
				
				    // 17. Dupliquer DATE OBT AGREMENT pour créer Réception agrément date
				    #"Duplication de la colonne1" = Table.DuplicateColumn(
				        #"Colonnes renommées1",
				        "DATE OBT AGREMENT",
				        "DATE OBT AGREMENT - Copier"
				    ),
				
				    #"Colonnes renommées2" = Table.RenameColumns(
				        #"Duplication de la colonne1",
				        {{"DATE OBT AGREMENT - Copier", "Réception agrément date"}}
				    ),
				
				    // 18. Typer les deux colonnes date
				    #"Type modifié3" = Table.TransformColumnTypes(
				        #"Colonnes renommées2",
				        {{"Dépot agrément graph", type date}, {"Réception agrément date", type date}}
				    )
				
				in
				    #"Type modifié3"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

