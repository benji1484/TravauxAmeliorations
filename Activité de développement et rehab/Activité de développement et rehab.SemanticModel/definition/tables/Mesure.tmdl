	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Affaires Indécence en instance' =
			
			CALCULATE(
			    DISTINCTCOUNT(indicateurs_affaires_v2[code_affaire]),
			    FILTER(
			        indicateurs_affaires_v2,
			        indicateurs_affaires_v2[statut_affaire] <> "Traitée" &&
			        indicateurs_affaires_v2[statut_affaire] <> "Close" &&
			        indicateurs_affaires_v2[lbl_type_affaire] = "INDECENCE LOGEMENT"
			    )
			)
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: fd9ecae9-c34c-4771-9923-9fe8ca585445

		changedProperty = Name
