	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre Logements prévisionnels' = CALCULATE(sum(LIVRAISONS[NB LOGTS]), USERELATIONSHIP(LIVRAISONS[Livraison prévisionnelle], DateTable[Date]))
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 5d82699c-cdf3-493a-ab94-2769061a15f8

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine.
	measure 'Prévisionnel livraison graph' = CALCULATE(SUM('LIVRAISONS'[NB LOGTS]), USERELATIONSHIP('LIVRAISONS'[Livraison prévisionnelle], 'Calendrier graphique'[Date]))
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 71c823e1-5c96-4e02-8304-4d978aa65c3e

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine.
	measure 'réel livraison graph' = CALCULATE(SUM('LIVRAISONS'[NB LOGTS]), USERELATIONSHIP('LIVRAISONS'[Livraison réelle], 'Calendrier graphique'[Date]))
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 6d0ebd88-3712-4f9b-9801-c8cd85beaea4

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine. La comparaison se fait avec la même période de l'année précédente.
	measure 'Prévisionnel cumulé' = TOTALYTD([Prévisionnel livraison graph], 'Calendrier graphique'[Date])
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 2ca969cf-2f1b-47ac-b68a-9e7505cb613f

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine. La comparaison se fait avec la même période de l'année précédente.
	measure 'Réel cumulé' =
			
			VAR _DernierJourDisponible = TODAY()
			RETURN
			IF (
			    MIN('Calendrier graphique'[Date]) <= _DernierJourDisponible,
			    TOTALYTD([réel livraison graph], 'Calendrier graphique'[Date]),
			    BLANK()
			)
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 0c8e1e5b-5dcc-45ac-af93-eb35ba15c674

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine.
	measure 'Titre Dynamique' =
			
			VAR _Annee = SELECTEDVALUE('Calendrier graphique'[Année], YEAR(TODAY()))
			RETURN
			"Réel cumulé des livraisons - Année " & _Annee
		displayFolder: Patrimoine
		lineageTag: 18bad5fd-0262-4b1f-a2bd-49496ca9e70b

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Prévisionnel mises en chantier graph' = CALCULATE(SUM('MEC'[NB LOGTS]), USERELATIONSHIP('MEC'[Prévisonnel graph], 'Calendrier graphique'[Date]))
		displayFolder: Temps
		formatString: 0
		lineageTag: b1ae4943-36fb-4d4e-a864-1d0957576411

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps. La comparaison se fait avec la même période de l'année précédente.
	measure 'Prévisionnel cumulé mise en chantier' = TOTALYTD([Prévisionnel mises en chantier graph], 'Calendrier graphique'[Date])
		displayFolder: Temps
		formatString: 0
		lineageTag: 9cfdccb3-95e9-4c41-a110-6c22f26fa9b9

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'réel mise en chantier graph' = CALCULATE(SUM('MEC'[NB LOGTS]), USERELATIONSHIP('MEC'[Réel graph], 'Calendrier graphique'[Date]))
		displayFolder: Temps
		formatString: 0
		lineageTag: f85bb8ba-bd09-493c-90ec-a1787aa5d52f

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps. La comparaison se fait avec la même période de l'année précédente.
	measure 'Réel MEC cumulé' =
			
			VAR _DernierJourDisponible = TODAY()
			RETURN
			IF (
			    MIN('Calendrier graphique'[Date]) <= _DernierJourDisponible,
			    TOTALYTD([réel mise en chantier graph], 'Calendrier graphique'[Date]),
			    BLANK()
			)
		displayFolder: Temps
		formatString: 0
		lineageTag: 3e22e54b-ac60-4104-a695-c6911ffee12d

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Agréments déposés' = CALCULATE(SUM('PROGR'[NB LOGTS]), USERELATIONSHIP(PROGR[Dépot agrément graph], 'Calendrier graphique'[Date]))
		displayFolder: Temps
		formatString: 0
		lineageTag: 7dc30839-665c-4c1f-81ab-e222ed7bdf89

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps. La comparaison se fait avec la même période de l'année précédente.
	measure 'Agréments déposés cumulés' = TOTALYTD([Agréments déposés], 'Calendrier graphique'[Date])
		displayFolder: Temps
		formatString: 0
		lineageTag: 4ff3b06e-14bc-4045-9f5a-63ba4e53118d

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Agréements reçus' = CALCULATE(SUM('PROGR'[NB LOGTS]), USERELATIONSHIP('PROGR'[Réception agrément date], 'Calendrier graphique'[Date]))
		displayFolder: Temps
		formatString: 0
		lineageTag: 91312416-ec21-47e9-844e-0664b8b9eaa1

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps. La comparaison se fait avec la même période de l'année précédente.
	measure 'Agréments reçus cumulés' =
			
			VAR _DernierJourDisponible = TODAY()
			RETURN
			IF (
			    MIN('Calendrier graphique'[Date]) <= _DernierJourDisponible,
			    TOTALYTD([Agréements reçus], 'Calendrier graphique'[Date]),
			    BLANK()
			)
		displayFolder: Temps
		formatString: 0
		lineageTag: f8106584-9438-4282-9a25-ff3b16954b53

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine.
	measure 'Prévisionnel livraison PSLA' = CALCULATE(SUM('LIVRAISONS'[NB LOGTS]),Produit[PRODUIT] = "PSLA", USERELATIONSHIP('LIVRAISONS'[Livraison prévisionnelle], 'Calendrier graphique'[Date]))
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 003599a0-f53f-494c-a3b2-7a158a5126d7

		changedProperty = Name
	/// Sert à comparer un résultat à un objectif de pilotage.
	measure 'Objectif agrément' = "/ 600"
		displayFolder: Objectifs
		lineageTag: a87672c5-cf8c-4248-8ed9-397d0a6f8874

		changedProperty = Name
	/// Sert à comparer un résultat à un objectif de pilotage.
	measure 'Objectifs agréments 2026' = 600
		displayFolder: Objectifs
		formatString: 0
		lineageTag: a2142e43-74b2-4de8-be72-d2110c68aaad

		changedProperty = Name
	/// Indique une proportion simple à interpréter.
	measure 'Cible mises en chantiers' = COALESCE([Réel MEC cumulé], 0) & " / 520"
		displayFolder: Indicateurs généraux
		lineageTag: 43245af5-b1cd-4220-94e5-2b5459a8b9e0

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Nombre d''opé déposées' = CALCULATE(DISTINCTCOUNT('PROGR'[POT]), USERELATIONSHIP(PROGR[Dépot agrément graph], 'Calendrier graphique'[Date]))
		displayFolder: Temps
		formatString: 0
		lineageTag: 62b80300-8962-4e1d-aee0-2c2f284c5876

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Nombre d''opérations reçus' = CALCULATE(DISTINCTCOUNT(PROGR[POT]), USERELATIONSHIP('PROGR'[Réception agrément date], 'Calendrier graphique'[Date]))
		displayFolder: Temps
		formatString: 0
		lineageTag: ba926b02-79d3-4f73-9f19-bcb9bacf52f1

		changedProperty = Name
	/// Indicateur métier utilisé pour le pilotage.
	measure 'Mesure 9'
		displayFolder: Indicateurs généraux
		lineageTag: cd5b48de-4df6-4beb-9f7a-20c55276ca4b
	/// Compte un nombre d'éléments distincts.
	measure 'Nombre agréments en cours' = CALCULATE(sum(PROGR[NB LOGTS]), PROGR[Statut] = "Agréments en cours")
		displayFolder: Indicateurs généraux
		formatString: 0
		lineageTag: 37b97c6f-a8bd-4b47-8908-2495f255cff6

		changedProperty = Name
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Taux de mise en chantier' = CALCULATE(sum(MEC[NB LOGTS]), MEC[ANNEE DE MEC] <> "") / CALCULATE(sum(MEC[NB LOGTS]))
		displayFolder: Temps
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: d59b7d54-9552-4db9-9937-31295a601661

		changedProperty = Name

		changedProperty = FormatString
	/// Sert à comparer ou cumuler un indicateur dans le temps.
	measure 'Nombre de mises en chantier' = CALCULATE(sum(MEC[NB LOGTS]), MEC[ANNEE DE MEC] <> "")
		displayFolder: Temps
		formatString: 0
		lineageTag: 8ce71d42-1ae9-45a3-b6f8-a7bf68faa50e

		changedProperty = Name
	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de logements prévus en LBU' = CALCULATE(sum(MEC[NB LOGTS]))
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 15b8f4ec-8eaf-460f-8f61-7c46244240d1

		changedProperty = Name
	/// Indique une proportion simple à interpréter.
	measure 'Cible agréments' = [Agréments reçus cumulés] & " / 600"
		displayFolder: Indicateurs généraux
		lineageTag: ed354b77-a41e-46ef-b674-64f3d3991780

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine.
	measure 'Délais moyens de chantier' = CALCULATE(AVERAGE('LIVRAISONS'[DUREE CHANTIER REELLE (en mois)]), USERELATIONSHIP('LIVRAISONS'[Livraison réelle], 'Calendrier graphique'[Date]))
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 405fb8b8-18c5-4b53-af39-b1e2f3936ddc

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine. La comparaison se fait avec la même période de l'année précédente.
	measure 'Délais moyens de chantier année précédente' =
			
			CALCULATE(
			    SUM('LIVRAISONS'[DUREE CHANTIER REELLE (en mois)]),
			    USERELATIONSHIP(
			        'LIVRAISONS'[Livraison réelle],
			        'Calendrier graphique'[Date]
			    ),
			    SAMEPERIODLASTYEAR('Calendrier graphique'[Date])
			)
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 6e0429a1-71c1-477c-aac6-4247e10aa7b0

		changedProperty = Name
	/// Mesure le montant ou le volume lié à la vacance.
	measure 'Vacance commerciale - Commerces et Bureaux' = EXTERNALMEASURE("Vacance commerciale - Commerces et Bureaux", DOUBLE, "DirectQuery à AS – Pilotage Mensuelv4")
		displayFolder: Vacance\Physique
