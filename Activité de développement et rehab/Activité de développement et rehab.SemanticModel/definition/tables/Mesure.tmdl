	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de EPFR' =
			
			VAR Annee = 2026
			RETURN
			CALCULATE(
			    SUM('Data'[Nbre de logts]),
			    'Data'[Etat] = "ACQUISITION",
			    NOT(ISBLANK('Data'[Signature effective acte et convention])),
			    Data[Situation RF] = "Convention EPFR signée",
			    'Data'[Année] = Annee
			)
		displayFolder: Patrimoine
		formatString: 0
		lineageTag: 648f0fc2-7753-486b-a653-bcec9f95a2a4

		changedProperty = Name
	/// Suit un indicateur descriptif du patrimoine.
	measure 'k€ EPFR' =
			
			VAR Annee = MAX('Data'[Année])
			RETURN
			CALCULATE(
			    SUM(Data[Prix d'acquisition]),
			    'Data'[Etat] = "ACQUISITION",
			    NOT(ISBLANK('Data'[Signature effective acte et convention])),
			    Data[Situation RF] = "Convention EPFR signée",
			    'Data'[Année] = Annee
			)
		displayFolder: Patrimoine
		lineageTag: 87446f65-fece-4a34-9a1d-719fc6b22821

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}
