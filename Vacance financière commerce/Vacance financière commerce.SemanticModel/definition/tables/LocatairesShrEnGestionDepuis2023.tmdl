	column Tranche_Age = ```
			
			SWITCH(
			    TRUE(),
			    'LocatairesShrEnGestionDepuis2023'[age_tiers] < 0 || 'LocatairesShrEnGestionDepuis2023'[age_tiers] > 110, BLANK(), -- Exclusion des valeurs hors limites
			    'LocatairesShrEnGestionDepuis2023'[age_tiers] < 25, "-_25_A",
			    'LocatairesShrEnGestionDepuis2023'[age_tiers] >= 25 && 'LocatairesShrEnGestionDepuis2023'[age_tiers] <= 34, "25_34_A",
			    'LocatairesShrEnGestionDepuis2023'[age_tiers] >= 35 && 'LocatairesShrEnGestionDepuis2023'[age_tiers] <= 44, "35_44_A",
			    'LocatairesShrEnGestionDepuis2023'[age_tiers] >= 45 && 'LocatairesShrEnGestionDepuis2023'[age_tiers] <= 59, "45_59_A",
			    'LocatairesShrEnGestionDepuis2023'[age_tiers] >= 60, "60_A_plus",
			    BLANK()
			)
			
			```
		lineageTag: 9ce15d03-a028-4ab1-86ce-7610cadf6edb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

