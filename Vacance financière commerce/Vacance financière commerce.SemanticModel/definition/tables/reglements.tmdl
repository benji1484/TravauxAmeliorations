	partition reglements = m
		mode: import
		source =
				let
				    Source = DremioCloud.DatabasesByServerV370("sql.eu.dremio.cloud", "bb13fbc3-7445-4b39-a699-0f45a59226b2", null, null, null, null, []),
				    #"ArticSpace.3_Business_Apps.DEV - Benjamin.Pilotage Mensuel_Schema" = Source{[Name="ArticSpace.3_Business_Apps.DEV - Benjamin.Pilotage Mensuel",Kind="Schema"]}[Data],
				    reglementsSHR_View = #"ArticSpace.3_Business_Apps.DEV - Benjamin.Pilotage Mensuel_Schema"{[Name="reglementsSHR",Kind="View"]}[Data],
				    // Ajouter une colonne pour convertir le champ "période" en date
				    AddDateColumn = Table.AddColumn(reglementsSHR_View, "DatePeriode", each Date.FromText([periode] & "-01"), type date),
				    // Obtenir la date du début des trois derniers mois
				    StartDate = Date.AddMonths(Date.From(DateTime.LocalNow()), -25),
				    // Filtrer les données pour ne garder que les trois derniers mois
				    FilteredRows = Table.SelectRows(AddDateColumn, each [DatePeriode] >= StartDate),
