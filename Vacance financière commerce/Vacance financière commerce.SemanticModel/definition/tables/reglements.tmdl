	column Categorie_Aide = ```
			
			SWITCH(
			    TRUE(),
			    SEARCH("CCAS", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "CCAS",
			    SEARCH("RAPPEL", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "RAPPEL AL",
			    SEARCH("FSL", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "FSL",
			    SEARCH("ACTION LGT", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "ACTION LOGE",
			    SEARCH("ACTION LOGE", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "ACTION LOGE",
			    SEARCH("PAIERIE", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "PAIERIE",
			    SEARCH("PAIERIE DEP", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "PAIERIE DEP",
			    SEARCH("CAF", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "CAF",
			    SEARCH("CGSS", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "CGSS",
			    SEARCH("CRR", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "CRR",
			    SEARCH("SGC", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "SGC",
			    SEARCH("CAISSE REUN", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "CAISSE REUN",
			    SEARCH("FONDAT ABBE", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "FONDATION ABBE PIERRE",
			    SEARCH("FONDATION AB", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "FONDATION ABBE PIERRE",
			    SEARCH("ALS", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "ACTION LOGE",
			    SEARCH("SOLI AL", UPPER('reglements'[lbl_ecriture_ca]), 1, 0) > 0, "SOLIDARITÉ ALLOCATION",
			    "Pas une aide"
			)
			
			```
		lineageTag: 3a5c2e9d-6c17-4d57-9fa4-82b4ebe7d1f6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Catégorie règlement' = ```
			
			SWITCH(
			    TRUE(),
			
			    // 🔄 SOLI AL reclassé en "Virements"
			    reglements[lbl_operation] = "Co financement SOLI AL", "Virements",
			
			    reglements[lbl_operation] = "Chag accompa person CALB", "Chq accompagmt personnal",
			    reglements[lbl_operation] = "Règlement par virement", "Virements",
			    reglements[lbl_operation] = "Ann reglement virement", "Ann. règlement virement",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "CHEQUES"
			        && reglements[lbl_mode_paiement] = "remise cheque"
			        && reglements[lbl_operation] = "Ann. règlement chèque", "Ann. règlement chèque",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "VIREMENTS"
			        && reglements[lbl_operation] = "Ann. règlement virement", "Ann. règlement virement",
			
			    reglements[lbl_type_operation] = "règlement"
			        && reglements[lbl_famille_operation] = "Autre"
			        && reglements[lbl_mode_paiement] = "Carte bancaire", "Carte bancaire",
			
			    reglements[lbl_type_operation] = "règlement"
			        && reglements[lbl_famille_operation] = "Carte Bleue Telephone"
			        && reglements[lbl_mode_paiement] = "CB par téléphone", "Carte bancaire",
			
			    reglements[lbl_type_operation] = "règlement"
			        && reglements[lbl_famille_operation] = "CHEQUES", "Chèque",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "CHEQUES"
			        && reglements[lbl_operation] = "chèque impayé", "Chèque impayé",
			
			    reglements[lbl_type_operation] = "règlement"
			        && reglements[lbl_famille_operation] = "Autre"
			        && reglements[lbl_operation] = "Chq accompagmt personnal", "Chq accompagmt personnal",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "DIVERS", "Divers",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "Autre"
			        && reglements[lbl_operation] = "Encaissement recouvremt", "Encaissement recouvremt",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "Autre"
			        && reglements[lbl_operation] = "Encaissement SRR", "Encaissement SRR",
			
			    reglements[lbl_type_operation] = "règlement en espèce"
			        && reglements[lbl_famille_operation] = "ESPECES"
			        && reglements[lbl_mode_paiement] = "ENCAISSEMENT PAR VIRT", "Espèces",
			
			    reglements[lbl_type_operation] = "admission non valeur"
			        && reglements[lbl_famille_operation] = "Passage en perte"
			        && reglements[lbl_operation] = "Passage en PP", "Passage en PP",
			
			    reglements[lbl_type_operation] = "admission non valeur"
			        && reglements[lbl_famille_operation] = "Passage en perte"
			        && reglements[lbl_operation] = "Passage en PP Judiciaire", "Passage en PP Judiciaire",
			
			    reglements[lbl_type_operation] = "prélèvement"
			        && reglements[lbl_famille_operation] = "PRELEVEMENTS", "Prélèvements",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "PRELEVEMENTS"
			        && reglements[lbl_mode_paiement] = "prélvt impayé"
			        && reglements[lbl_operation] = "Prélèvement impayé", "Prélèvements impayé",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "DIVERS"
			        && reglements[lbl_operation] = "Profit exp", "Profit exp",
			
			    reglements[lbl_operation] = "Réglement IBAN virtuel", "Réglement IBAN virtuel",
			
			    reglements[lbl_type_operation] = "opération diverse hors facturation"
			        && reglements[lbl_famille_operation] = "Remboursement", "Rembourssement Locataire",
			
			    reglements[lbl_type_operation] = "règlement"
			        && reglements[lbl_famille_operation] = "VIREMENTS", "Virements",
			
			    BLANK()
			)
			
			```
		lineageTag: 8b85ea01-0f06-443d-8093-9b5a890a6861
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"reglements","TableItemName":"Catégorie règlement (groupes)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Catégorie règlement (groupes)' =
			SWITCH(
				TRUE,
				ISBLANK('reglements'[Catégorie règlement]),
				"(Vide)",
				'reglements'[Catégorie règlement] IN {"Ann. règlement chèque",
					"Ann. règlement virement",
					"Chèque impayé",
					"Chq accompagmt personnal",
					"Divers",
					"Encaissement recouvremt",
					"Encaissement SRR",
					"Passage en PP",
					"Passage en PP Judiciaire",
					"Prélèvements impayé",
					"Rembourssement Locataire"},
				"Autres",
				'reglements'[Catégorie règlement]
			)
		lineageTag: f57570a0-0134-4313-8c3a-57991a8d400d
		summarizeBy: none

