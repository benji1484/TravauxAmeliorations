	/// Compte les entrées, sorties ou mouvements des locataires. La comparaison se fait avec la même période de l'année précédente.
	measure 'Nombre d''entrées de salariés cumulées annuelles' = CALCULATE(TOTALYTD([Nombre d'entrées], DateTable[Date]), PeuplementShrDepuis2023[ind_Emploi] >= 1)
