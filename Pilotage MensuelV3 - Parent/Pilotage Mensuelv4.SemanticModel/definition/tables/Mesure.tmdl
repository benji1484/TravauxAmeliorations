	measure 'Livraisons cumulées alt' = ```
			
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            PatrimoineSrhEnGestionDepuis2023,
			                       PatrimoineSrhEnGestionDepuis2023[code_nature_ug] IN {"LGH", "LGT"}
			        )
			    )
			)
			
			```
