	measure 'Règlements hors passages en perte mois précédent' = ```
			
			CALCULATE(
			    -1 * SUM(reglements[montant_ecriture_ca]),
			    DATESMTD(PREVIOUSMONTH(DateTable[Date])),
			    reglements[code_operation] <> "NVA"
			)
			
