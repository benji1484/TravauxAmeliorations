	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre d''étages' =
			
			IF (
			    COUNTROWS ( VALUES ( 'UG - Lib Patrimoine'[Patrimoine]) )  >= 2,
			    BLANK(),  // ou bien "-", selon si tu veux du texte
			    MAX ( PatrimoineSrhEnGestionDepuis2023[Etage numerique] )
