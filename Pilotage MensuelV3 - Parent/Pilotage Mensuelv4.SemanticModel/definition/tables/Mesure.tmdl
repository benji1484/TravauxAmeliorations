	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure T1 = CALCULATE(DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_type_ug]), ALLEXCEPT(PatrimoineSrhEnGestionDepuis2023, PatrimoineSrhEnGestionDepuis2023[code_HP1], 'UG - Lib Patrimoine'[Patrimoine]), PatrimoineSrhEnGestionDepuis2023[code_type_ug] = "T1")
		formatString: 0
