		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Compte les logements, commerces ou unités concernés par une situation de vacance. Le résultat est cumulé depuis le début de l'année.
	measure 'Armos Quittancement Théorique' = ([Cumul Quittancements Annuel] ) + [Vacance financière recalculée cumulée annuelle]
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Vacance\Financière
		lineageTag: 51c3b571-d6d3-48a4-b823-9c1bbd2f51c1

	/// Compte les logements, commerces ou unités concernés par une situation de vacance. Le résultat est cumulé depuis le début de l'année.
	measure 'Montant total des vacances élevées' =
			
			SUMX(
			    FILTER(
			        IndicateursVacanceShrEnGestionDepuis2023,
			        IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceYTD_ug] > 0 &&
			                IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceYTD_ug] > 3 * IndicateursVacanceShrEnGestionDepuis2023[LoyerTheo_TTCm_ug] && IndicateursVacanceShrEnGestionDepuis2023[code_nature_ug] in {"LGT", "LGH", "LGE"}
			    ),
			    IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceYTD_ug]
			)
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Vacance\Financière
		lineageTag: 61654adb-ad6c-4ca4-9d5e-67ec237449ce

	/// Compte les logements, commerces ou unités concernés par une situation de vacance. Le résultat est cumulé depuis le début de l'année.
	measure 'Vacance < 3M' = [Vacance financière logements cumulée annuelle] - [Montant total des vacances élevées]
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Vacance\Financière
		lineageTag: 9e33d9a3-b588-4185-b77c-79ae5b3d4740

	/// Mesure le montant ou le volume lié à la vacance.
	measure 'Vacance liée aux ventes par UG' = ```
			
			CALCULATE(
			    SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceVendum_ug]),
			    FILTER(
			        ALLEXCEPT(
			            IndicateursVacanceShrEnGestionDepuis2023, 
