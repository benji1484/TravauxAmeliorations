	/// Mesure le montant ou le volume lié à la vacance.
	measure 'Loyers Quittançables HC' = ```
			
			CALCULATE(
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[loyerHCm_ca_operation])+SUM(IndicateursFinanciersShrEnGestionDepuis2023[autresfactum_ca_operation]),
			    NOT(LocatairesShrEnGestionDepuis2023[code_nature_ug] IN {"PSL", "LIB"})
			) + 
			CALCULATE( SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceHCm_ug]), not(IndicateursFinanciersShrEnGestionDepuis2023[code_nature_ug] in {"PSL", "LIB"})
			)
			```
