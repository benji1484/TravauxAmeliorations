	/// Indique une proportion liée aux impayés ou à l'évolution de la dette.
	measure 'Taux de croissance de la dette positive' = if(([Dette positive hors passages en perte] - [Dette positive du mois précédent]) / ([Dette positive du mois précédent])>0, ([Dette positive hors passages en perte] - [Dette positive du mois précédent]) / ([Dette positive du mois précédent]), BLANK())
		displayFolder: Dette et impayés
		lineageTag: 2f4dbb95-fb98-4bd8-b024-21f3d49fa8f3

