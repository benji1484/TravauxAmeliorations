	/// Compte les logements, commerces ou unités concernés par une situation de vacance. Le résultat est cumulé depuis le début de l'année.
	measure 'Vacance financière hors charges recalculée cumulée annuelle' = ```
			
			CALCULATE(
			    SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceHCm_ug]),
			    FILTER(
			        ALLEXCEPT(
			            IndicateursVacanceShrEnGestionDepuis2023, 
			            IndicateursVacanceShrEnGestionDepuis2023[code_ho2], IndicateursVacanceShrEnGestionDepuis2023[code_ug], 'catégorie'[code_categorie_ug],
			            MapTerritoire[Code_ho2], 
			            MapTerritoire[Territoire], 
			            MapTerritoire[xAgence], 'UG - Lib Patrimoine'[Adresse_complete], 'UG - Lib Patrimoine'[lbl_commune], 
			            IndicateursVacanceShrEnGestionDepuis2023[code_nature_ug], 
			            'Nature UG'[GroupeNature], UG_INSEE[code_insee], 'UG - Lib Patrimoine'[lbl_patrimoine_ptm], 'UG - Lib Patrimoine'[code_HP1]
			        ),
			        IndicateursVacanceShrEnGestionDepuis2023[periode] <= MAX(IndicateursVacanceShrEnGestionDepuis2023[periode]) &&
			        LEFT(IndicateursVacanceShrEnGestionDepuis2023[periode], 4) = LEFT(MAX(IndicateursVacanceShrEnGestionDepuis2023[periode]), 4)
			    )
			)
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
