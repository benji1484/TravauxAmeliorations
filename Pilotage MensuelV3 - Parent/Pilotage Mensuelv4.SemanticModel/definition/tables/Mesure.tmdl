	measure 'Passages en perte' = CALCULATE(sum(IndicateursFinanciersShrEnGestionDepuis2023[passage_en_perte_CAm]), IndicateursFinanciersShrEnGestionDepuis2023[passage_en_perte_CAm] > 0 )
