	/// Additionne les montants facturés, encaissés ou liés aux allocations. La comparaison se fait avec le mois précédent.
	measure 'Quittancé cumul annuel mois précédent' = ```
			
			VAR CurrentPeriode = MAX(IndicateursFinanciersShrEnGestionDepuis2023[periode])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriode, 4))
			VAR CurrentMonth = VALUE(RIGHT(CurrentPeriode, 2))
			
			VAR RetardMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)
			VAR RetardYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)
			VAR RetardPeriode = FORMAT(RetardYear, "0000") & "-" & FORMAT(RetardMonth, "00")
			
			RETURN
			CALCULATE(
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]),
			    FILTER(
			        ALLEXCEPT(
			            IndicateursFinanciersShrEnGestionDepuis2023, 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_type_ca], 
			            IndicateursFinanciersShrEnGestionDepuis2023[statut_caug], 
			            IndicateursFinanciersShrEnGestionDepuis2023[dimension_ca], 
			            code_type_ca[Type_Locataire], 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_ho2], 
			            MapTerritoire[Code_ho2], 
			            MapTerritoire[Territoire], 
			            MapTerritoire[xAgence], 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_ca], 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_nature_ug], 
			            'Nature UG'[GroupeNature], 
			            UG_INSEE[code_ug], 
			            UG_INSEE[code_insee], 
			            'UG - Lib Patrimoine'[lbl_patrimoine_ptm], 
			            'UG - Lib Patrimoine'[code_HP1]
			        ),
			        IndicateursFinanciersShrEnGestionDepuis2023[periode] <= RetardPeriode &&
			        LEFT(IndicateursFinanciersShrEnGestionDepuis2023[periode], 4) = FORMAT(RetardYear, "0000")
			    )
			)
			
			```
		displayFolder: Encaissement et quittancement
		lineageTag: c86a60a1-c60d-496c-8152-679b359ec682

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure Quitm_CA_Operation_Annuel = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriod, 4))
			RETURN
			CALCULATE(
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]),
			    FILTER(
			        ALL(PeriodeCal),
			        VALUE(LEFT(PeriodeCal[période], 4)) = CurrentYear
			    )
			)
			
			```
		displayFolder: À vérifier
		lineageTag: a078fc73-4df2-413c-8db0-31e2c9ad79b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Additionne les montants facturés, encaissés ou liés aux allocations. La comparaison se fait avec le mois précédent.
	measure 'Quittancement mois précédent Total Cumule Annuel' = ```
			
			VAR CurrentPeriod = SELECTEDVALUE(PeriodeCal[Période])
			VAR CurrentYear = LEFT(CurrentPeriod, 4)
			
			RETURN
			SUMX(
			    FILTER(
			        ALL(PeriodeCal),
			        LEFT(PeriodeCal[Période], 4) = CurrentYear &&
			        PeriodeCal[Période] <= CurrentPeriod
			    ),
			    VAR Period = PeriodeCal[Période]
			    VAR Year = LEFT(Period, 4)
			    VAR Month = RIGHT(Period, 2)
			    VAR PrevYear = IF(Month = "01", FORMAT(VALUE(Year) - 1, "0000"), Year)
			    VAR PrevMonth = IF(Month = "01", "12", FORMAT(VALUE(Month) - 1, "00"))
			    VAR PrevPeriod = PrevYear & "-" & PrevMonth
			
			    VAR ValueM1 =
			        CALCULATE(
			            SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]),
			            FILTER(
			                ALL(PeriodeCal),
			                PeriodeCal[Période] = PrevPeriod
			            )
			        )
			    RETURN
			        IF(NOT ISBLANK(ValueM1), ValueM1, 0)
			)
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Encaissement et quittancement
		lineageTag: 9bf7a193-0426-4893-afa7-33cfb2a5f1bd

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure Encaissement_Alloc_Cumul_Annuel = ```
			
			VAR CurrentPeriod = SELECTEDVALUE(PeriodeCal[période])
			VAR CurrentYear = LEFT(CurrentPeriod, 4)
			
			RETURN
			CALCULATE(
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[encaissm_ca_operation]) +
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[allocm_ca_operation]) -
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[passage_en_perte_CAm]),
			    
			    FILTER(
			        ALL(PeriodeCal),
			        LEFT(PeriodeCal[période], 4) = CurrentYear &&
			        PeriodeCal[période] <= CurrentPeriod
			    )
			)
			
			```
		displayFolder: À vérifier
		lineageTag: 4c69381f-93e6-46a5-80ad-f2a492104274

		annotation PBI_FormatHint = {"isGeneralNumber":true}

