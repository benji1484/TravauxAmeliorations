	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Nombre de logements en vacance stratégique' = ```
			CALCULATE([Nombre d'UG], PatrimoineSrhEnGestionDepuis2023[code_etat_ug] in {"VVO", "VDE", "VEN"}, 'Nature UG'[code_nature_ug] in {"LGT", "LGH"}) 
