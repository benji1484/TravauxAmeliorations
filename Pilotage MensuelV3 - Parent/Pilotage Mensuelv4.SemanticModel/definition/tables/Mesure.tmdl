	/// Additionne les montants facturés, encaissés ou liés aux allocations. La comparaison se fait avec le mois précédent.
	measure 'Règlements hors passages en perte douze mois avant' = ```
			
			CALCULATE(
			    -1 * SUM(reglements[montant_ecriture_ca]),
			    FILTER(
			        ALL(DateTable),
			        DateTable[Date] >= EDATE(MIN(DateTable[Date]), -12)
			        && DateTable[Date] <= EDATE(MAX(DateTable[Date]), -12)
			    ),
