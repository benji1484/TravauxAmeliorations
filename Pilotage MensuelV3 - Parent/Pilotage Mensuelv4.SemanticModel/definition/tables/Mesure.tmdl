	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Vacance technique totale par UG' = ```
			
			CALCULATE(
			    SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceTechm_ug]),
			    FILTER(
			        ALLEXCEPT(
			            IndicateursVacanceShrEnGestionDepuis2023, 
			            IndicateursVacanceShrEnGestionDepuis2023[code_ho2], 
			            MapTerritoire[Code_ho2], 
			            MapTerritoire[Territoire], 
			            MapTerritoire[xAgence],             IndicateursVacanceShrEnGestionDepuis2023[batiment],
			            'UG - Lib Patrimoine'[lbl_patrimoine_ptm],
			            IndicateursVacanceShrEnGestionDepuis2023[code_nature_ug], 
			            'Nature UG'[GroupeNature], UG_INSEE[code_insee]
			        ),
			        IndicateursVacanceShrEnGestionDepuis2023[periode] <= MAX(IndicateursVacanceShrEnGestionDepuis2023[periode]) &&
			        LEFT(IndicateursVacanceShrEnGestionDepuis2023[periode], 4) = LEFT(MAX(IndicateursVacanceShrEnGestionDepuis2023[periode]), 4)
			    )
			)
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Vacance\Physique
		lineageTag: 1a36dfa7-8028-49c4-97d6-0558b484d6f3

	/// Additionne les montants facturés, encaissés ou liés aux allocations.
	measure Règlements =
			
			sum(IndicateursFinanciersShrEnGestionDepuis2023[encaissm_ca_operation])
			-
			sum(IndicateursFinanciersShrEnGestionDepuis2023[passage_en_perte_CAm])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Encaissement et quittancement
		lineageTag: 073d5594-0ca5-4df3-9f7c-e5987dc2bfe6

	/// Mesure le montant ou le volume lié à la vacance.
	measure 'Loyers Quittançables TCC' = ```
			
			CALCULATE(
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]),
			    NOT(LocatairesShrEnGestionDepuis2023[code_nature_ug] IN {"PSL", "LIB"})
			) + 
			CALCULATE( SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacancem_ug]), not(IndicateursFinanciersShrEnGestionDepuis2023[code_nature_ug] in {"PSL", "LIB"})
			)
			```
		displayFolder: Vacance\Financière
		lineageTag: a74e70d6-f679-4e36-93ea-1d57e2f429b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure 'vacance mensuelle rali' = CALCULATE(sum(IndicateursVacanceShrEnGestionDepuis2023[TotalVacancem_ug]), not(IndicateursVacanceShrEnGestionDepuis2023[code_nature_ug]) in {"LIB", "PSL"})
		displayFolder: À vérifier
