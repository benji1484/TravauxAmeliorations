	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Nombre d''UG en vacance technique' = ```
			CALCULATE([Nombre d'UG], PatrimoineSrhEnGestionDepuis2023[code_etat_ug] in {"VAM", "VTX"}, 'Nature UG'[code_nature_ug] in {"LGT", "LGH"}) 
