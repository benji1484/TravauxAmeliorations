	/// Additionne les montants facturés, encaissés ou liés aux allocations. La comparaison se fait avec la même période de l'année précédente.
	measure 'Quittancement cumulé annuel' = TOTALYTD( [Quittancement], DateTable[Date])
		displayFolder: Encaissement et quittancement
		lineageTag: f391451d-75a3-4736-bcc0-9f4e9b392520

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Suit les montants restant dus, les impayés ou leur évolution. Le résultat est cumulé depuis le début de l'année.
	measure 'Variation annuelle de la dette' = ```
			
			VAR AnneeCourrante = Max(DateTable[Year]) 
			VAR DetteDecembreN1 = CALCULATE([Dette],REMOVEFILTERS(DateTable), DateTable[Month Number] = 12, DateTable[Year] = AnneeCourrante-1)
			RETURN
			[Dette] - DetteDecembreN1 + [Passages en perte cumulés annuels]
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Dette et impayés
		lineageTag: f842b283-3fb7-4a97-aa5e-60c901dd2189

	/// Suit la part des sommes encaissées par rapport aux sommes attendues. Le résultat est cumulé depuis le début de l'année.
	measure 'Taux d''encaissement cumulé annuel' = ```
			
			([Quittancement cumulé annuel] - [Variation annuelle de la dette])
			    / [Quittancement cumulé annuel]
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Encaissement et quittancement
		lineageTag: 03a05e78-3c19-48df-91a4-bc171599f197

	/// Suit les montants restant dus, les impayés ou leur évolution. La comparaison se fait avec le mois précédent.
	measure 'Montant Dette mois précédent' = CALCULATE([Dette hors passages en perte], PREVIOUSMONTH(DateTable[Date]))
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Dette et impayés
		lineageTag: 1601edf8-b48e-4fd0-8af7-9b2e00820afd

	/// Suit les montants restant dus, les impayés ou leur évolution. La comparaison se fait avec le mois précédent.
	measure 'Variation mensuelle de la dette' = ```
			
			VAR CurrentDate = MAX ( DateTable[Date] ) -- date courante du contexte
			VAR PreviousDate =
			    EOMONTH ( CurrentDate, -1 ) -- fin du mois précédent
			VAR IsJanuary = MONTH ( CurrentDate ) = 1
			VAR CumulPrevious =
			    CALCULATE (
			        [Passages en perte cumulés annuels],
			        DateTable[Date] = PreviousDate
			    )
			RETURN
			    IF (
			        IsJanuary,
			        ( [Dette hors passages en perte] - [Montant Dette mois précédent] ) + CumulPrevious,
			        ( [Dette hors passages en perte] - [Montant Dette mois précédent] )
			    )
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Dette et impayés
		lineageTag: 2050313a-3eda-42a5-aa2e-0d5812c1d8e6

	/// Suit la part des sommes encaissées par rapport aux sommes attendues.
	measure 'Taux d''encaissement mensuel' = ```
			
			([Quittancement] - [Variation mensuelle de la dette])
			    / [Quittancement]
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Encaissement et quittancement
		lineageTag: c2b865bb-3c71-41d1-9213-08339e5df046

	/// Suit la part des sommes encaissées par rapport aux sommes attendues. La comparaison se fait avec la même période de l'année précédente.
	measure 'Taux d''encaissement cumulé annuel année précédente' = CALCULATE([Taux d'encaissement cumulé annuel], SAMEPERIODLASTYEAR(DateTable[Date]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Encaissement et quittancement
		lineageTag: fb1b076a-337b-4e6f-b6e1-b91e11f8e866

	/// Suit la part des sommes encaissées par rapport aux sommes attendues. La comparaison se fait avec la même période de l'année précédente.
	measure 'Taux d''encaissement mensuel année précédente' = CALCULATE([Taux d'encaissement mensuel], SAMEPERIODLASTYEAR(DateTable[Date]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Encaissement et quittancement
		lineageTag: 6ef19c64-4060-4147-94f5-ccc0ccce902a

	/// Suit les montants restant dus, les impayés ou leur évolution.
	measure 'Dette des locataires présents' = CALCULATE([Dette hors passages en perte], IndicateursFinanciersShrEnGestionDepuis2023[statut_caug] = "Present")
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
