	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure VacanceFinancièreYTD_LastPériode =
			
			CALCULATE(
			    SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceYTD_ug]),
			    USERELATIONSHIP('PeriodeCal'[Période], IndicateursVacanceShrEnGestionDepuis2023[periode]),LASTNONBLANK('PeriodeCal'[Période],0)
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: À vérifier
		lineageTag: 95ef9bd9-a4f4-4876-ad57-6ba5e8136deb

