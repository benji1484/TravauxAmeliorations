		lineageTag: 436edfa5-9f81-4075-9e72-104708cc7f8a

	/// Indique la part de vacance par rapport au volume de référence, pour suivre le niveau de vacance.
	measure 'Part vacance stratégique' = CALCULATE(DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]), 'Nature UG'[code_nature_ug] in {"COM"}, PatrimoineSrhEnGestionDepuis2023[code_etat_ug] in {"VVO", "VEN", "VDE"})/[Nombre de commerces vacants]
