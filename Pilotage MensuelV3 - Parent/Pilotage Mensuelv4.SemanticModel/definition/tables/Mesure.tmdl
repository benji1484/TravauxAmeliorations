	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre d''UG' = DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug])
		formatString: 0
		displayFolder: Patrimoine
		lineageTag: 81bb516a-455a-4cef-b913-4c9fdaa40285

	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de livraisons mensuelles' = ```
			
			VAR AnneePeriode = VALUE(LEFT(SELECTEDVALUE('PeriodeCal'[Période]), 4))  -- Extraction de l'année de la période
			VAR MoisPeriode = VALUE(RIGHT(SELECTEDVALUE('PeriodeCal'[Période]), 2))  -- Extraction du mois de la période
			RETURN
			if(isblank(CALCULATE(
			    COUNTROWS(PatrimoineSrhEnGestionDepuis2023),
			    YEAR(PatrimoineSrhEnGestionDepuis2023[dte_ref]) = AnneePeriode &&
			    MONTH(PatrimoineSrhEnGestionDepuis2023[dte_ref]) = MoisPeriode
			,PatrimoineSrhEnGestionDepuis2023[code_nature_ug] in {"LGH","LGT"})), 0, CALCULATE(
			    COUNTROWS(PatrimoineSrhEnGestionDepuis2023),
			    YEAR(PatrimoineSrhEnGestionDepuis2023[dte_ref]) = AnneePeriode &&
			    MONTH(PatrimoineSrhEnGestionDepuis2023[dte_ref]) = MoisPeriode
			,PatrimoineSrhEnGestionDepuis2023[code_nature_ug] in {"LGH","LGT"}))
			
			```
		formatString: 0
		displayFolder: Patrimoine
		lineageTag: 1ba8d381-b6a4-4a2d-9f59-f73993c647a6

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure 'Autre variation de stock' = [Nombre d'UG] - [Nombre de livraisons mensuelles] - [# UG M1]
		formatString: 0
		displayFolder: À vérifier
		lineageTag: d9958cb0-805f-46d6-bf9e-cb75f9b8d247

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure '# UG M1' = ```
			
			VAR AnneePeriode = VALUE(LEFT(SELECTEDVALUE('PeriodeCal'[période]), 4))  -- Extraction de l'année de la période actuelle
			VAR MoisPeriode = VALUE(RIGHT(SELECTEDVALUE('PeriodeCal'[période]), 2))  -- Extraction du mois de la période actuelle
			
			-- Calcul de la période précédente
			VAR MoisPrecedent = IF(MoisPeriode = 1, 12, MoisPeriode - 1)  -- Si on est en janvier, revenir à décembre de l'année précédente
			VAR AnneePrecedente = IF(MoisPeriode = 1, AnneePeriode - 1, AnneePeriode)
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]),
			    YEAR('PeriodeCal'[période]) = AnneePrecedente &&
			    MONTH('PeriodeCal'[période]) = MoisPrecedent
			)
			
			```
		formatString: 0
		displayFolder: À vérifier
		lineageTag: 262bab50-526c-40e8-bea7-8772d9e11e71

	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de logements vacants' = ```
			CALCULATE([Nombre de logements], PatrimoineSrhEnGestionDepuis2023[code_etat_ug] <> "CTT") 
			```
