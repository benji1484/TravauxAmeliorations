	/// Indique la part de vacance par rapport au volume de référence, pour suivre le niveau de vacance. Le résultat est cumulé depuis le début de l'année.
	measure 'Taux de vacance financière cumulé annuel' =
			
			divide(
			  sumx(IndicateursVacanceShrEnGestionDepuis2023,
			  if(
			    ISBLANK(IndicateursVacanceShrEnGestionDepuis2023[TxVacFiYTD_ug]),0,
			    if(
			      IndicateursVacanceShrEnGestionDepuis2023[TxVacFiYTD_ug]+0=0,0, IndicateursVacanceShrEnGestionDepuis2023[TxVacFiYTD_ug]*IndicateursVacanceShrEnGestionDepuis2023[LoyerTheo_TTCYTD_ug]+0
			      )
			    )
			  ),
			  sumx(IndicateursVacanceShrEnGestionDepuis2023,IndicateursVacanceShrEnGestionDepuis2023[LoyerTheo_TTCYTD_ug]),0)
