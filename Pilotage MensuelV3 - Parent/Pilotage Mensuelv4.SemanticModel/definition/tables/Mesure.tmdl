	/// Mesure la part ou le rythme des mouvements d'occupation. La comparaison se fait avec la même période de l'année précédente.
	measure 'Mobilité année précédente' = CALCULATE([Mobilité mensuelle], SAMEPERIODLASTYEAR(DateTable[Date]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
