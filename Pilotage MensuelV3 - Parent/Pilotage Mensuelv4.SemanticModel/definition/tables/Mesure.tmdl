			        LEFT(PeuplementShrDepuis2023[periode], 4) = LEFT(MAX(PeuplementShrDepuis2023[periode]), 4) &&
			        PeuplementShrDepuis2023[periode] <= MAX(PeuplementShrDepuis2023[periode]) && PeuplementShrDepuis2023[ind_Emploi] >=1
			    )
			)
			
