		lineageTag: 163b2b6a-cced-4191-b812-cd85d4941039

	/// Indique la part de vacance par rapport au volume de référence, pour suivre le niveau de vacance.
	measure 'Part vacance stratégique dans la vacance globale' = [Vacance Stratégique logement] / [Nombre de logements vacants]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Vacance\Physique
		lineageTag: 54824f89-cc18-49ab-b324-316ecdb31aa4

	/// Sert à comparer un résultat à un objectif de pilotage.
	measure 'Variation du ratio d''intéressement vacance financière par agence' =
			
			VARX.P(
				KEEPFILTERS(VALUES('MapTerritoire'[xAgence])),
				CALCULATE([Ratio intéressement vacance financière commerces])
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
