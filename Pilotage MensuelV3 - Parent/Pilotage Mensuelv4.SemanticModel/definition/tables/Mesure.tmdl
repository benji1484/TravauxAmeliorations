	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de bâtiments' =
			
			COUNTROWS (
			    SUMMARIZE (
			        'PatrimoineSrhEnGestionDepuis2023',
			        'PatrimoineSrhEnGestionDepuis2023'[code_hp1],
