	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure TotalVacanceMEL_ug = ```
			
			CALCULATE(
			    SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceMELm_ug]),
			    FILTER(
			        ALLEXCEPT(
			            IndicateursVacanceShrEnGestionDepuis2023, 
			            IndicateursVacanceShrEnGestionDepuis2023[code_ho2], 
			            MapTerritoire[Code_ho2], 
			            MapTerritoire[Territoire], 
			            'UG - Lib Patrimoine'[lbl_patrimoine_ptm],            IndicateursVacanceShrEnGestionDepuis2023[batiment],
			            MapTerritoire[xAgence], 
			            IndicateursVacanceShrEnGestionDepuis2023[code_nature_ug], 
			            'Nature UG'[GroupeNature], UG_INSEE[code_insee]
			        ),
			        IndicateursVacanceShrEnGestionDepuis2023[periode] <= MAX(IndicateursVacanceShrEnGestionDepuis2023[periode]) &&
			        LEFT(IndicateursVacanceShrEnGestionDepuis2023[periode], 4) = LEFT(MAX(IndicateursVacanceShrEnGestionDepuis2023[periode]), 4)
			    )
			)
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: À vérifier
		lineageTag: ea1ba0cf-dda5-475b-b17b-21fe1343e268

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure CroissanceSoldem_CA_Operation_YTD_test = ```
			
			VAR MoisDecembre = 
			    CALCULATE(
			       SUMX(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            IF(
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation] > 0,
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation], 
			                0
			            )
			        ),
			        TREATAS( 
			            { MAX(PeriodeCal[Année])-1 & "-12" }, 
			            PeriodeCal[Période]
			        )
			    )
			RETURN 
			    CALCULATE(
			        SUMX(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            IF(
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation] > 0,
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation], 
			                0
			            )
			        ),
			        FILTER(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            LEFT(IndicateursFinanciersShrEnGestionDepuis2023[periode], 4) = format(Max(PeriodeCal[Année]), "0000")
			        ),
			        TREATAS(
			            VALUES(PeriodeCal[Période]), 
			            IndicateursFinanciersShrEnGestionDepuis2023[periode]
			        )
			    ) 
			```
		displayFolder: À vérifier
		lineageTag: c26c9cdf-dd0c-48f9-8a8c-0ddd3ce3f9e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure MoisDecembre = ```
			CALCULATE(
			       SUMX(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            IF(
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation] > 0,
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation], 
			                0
			            )
			        ),
			        TREATAS( 
			            { MAX(PeriodeCal[Année])-1 & "-12" }, 
			            PeriodeCal[Période]
			        )
			    )
			```
		displayFolder: À vérifier
		lineageTag: d9d74c44-c7e4-4745-9e23-5c7ffb43dde7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Indique une proportion liée aux impayés ou à l'évolution de la dette.
	measure Dette = CALCULATE(sum(IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation]), IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation] > 0)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Dette et impayés
		lineageTag: 50ab7973-868e-4112-b1ad-0d4965c50d65

	/// Suit les montants restant dus, les impayés ou leur évolution. La comparaison se fait avec la même période de l'année précédente.
	measure 'Montant Dette cumul annuel' = TOTALYTD([Dette], DateTable[Date])
		displayFolder: Dette et impayés
		lineageTag: 1ba9bf3a-7c59-456b-bb7e-7c7fcebb22dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

