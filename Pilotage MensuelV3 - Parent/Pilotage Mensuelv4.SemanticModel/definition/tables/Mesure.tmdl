	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de T1' = ```
			
			CALCULATE(
			    COUNTROWS(PatrimoineSrhEnGestionDepuis2023),
			    ALLEXCEPT(
			        PatrimoineSrhEnGestionDepuis2023,
			        PatrimoineSrhEnGestionDepuis2023[Nature_CSP],
			        PatrimoineSrhEnGestionDepuis2023[code_ho2],
			        'UG - Lib Patrimoine'[lbl_patrimoine_ptm],
			        'UG - Lib Patrimoine'[lbl_commune],
			        'UG - Lib Patrimoine'[code_HP1],
			        'UG - Lib Patrimoine'[Patrimoine],
			        MapTerritoire[Territoire],
			        MapTerritoire[xAgence],
			        'Nature UG'[GroupeNature]
			    ),
			    FILTER(
			        PatrimoineSrhEnGestionDepuis2023,
			        PatrimoineSrhEnGestionDepuis2023[code_type_ug] = "T1"
			            && PatrimoineSrhEnGestionDepuis2023[periode] =
			                CALCULATE(
			                    MAX(PatrimoineSrhEnGestionDepuis2023[periode]),
			                    FILTER(
			                        PatrimoineSrhEnGestionDepuis2023,
			                        PatrimoineSrhEnGestionDepuis2023[code_ug] = EARLIER(PatrimoineSrhEnGestionDepuis2023[code_ug])
			                    )
			                )
			    )
			)
			
			```
