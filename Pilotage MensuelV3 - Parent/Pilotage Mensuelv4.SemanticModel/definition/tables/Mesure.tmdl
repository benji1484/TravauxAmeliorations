	/// Sert à afficher un texte, une couleur ou un contenu de restitution dans le rapport. Le résultat est cumulé depuis le début de l'année.
	measure 'Couleur des entrées de salariés' = ```
			
			VAR ValeurActuelle = [Taux Entrées Salariés cumul annuel]
			VAR Cible = [Cible entrées salariés]
			
			RETURN
			SWITCH(
			    TRUE(),
			    ValeurActuelle < Cible, "#D94B5A",     
			    ValeurActuelle >= Cible, "#1FA64A", 
			    "#D94B5A"
			)
			```
		displayFolder: Restitution
		lineageTag: 3d40920e-8d27-486a-aa3f-c61dd3e4d7f6

	/// Sert à afficher un texte, une couleur ou un contenu de restitution dans le rapport. Le résultat est cumulé depuis le début de l'année.
	measure 'Couleur de la vacance' = ```
			
			VAR ValeurActuelle = [Vacance financière logements cumulée annuelle]
			VAR Cible = sum(Obj_2024[Obj_TotalVacanceYTDm_Logements])
			
			RETURN
			SWITCH(
			    TRUE(),
			    ValeurActuelle > Cible, "#D94B5A",     
			    ValeurActuelle <= Cible, "#1FA64A", 
			    "#D94B5A"
			)
			```
		displayFolder: Restitution
		lineageTag: f0cb4da2-0f22-44aa-b44a-41e6c97d1038

	/// Sert à afficher un texte, une couleur ou un contenu de restitution dans le rapport. Le résultat est cumulé depuis le début de l'année.
	measure 'Couleur de la dette' = ```
			
			VAR ValeurActuelle = [Variation annuelle de la dette]
			VAR Cible = sum(Obj_2024[Obj_Variation_soldeYTDm_ca_operation_Locataires])
			
			RETURN
			SWITCH(
			    TRUE(),
			    ValeurActuelle > Cible, "#D94B5A",     
			    ValeurActuelle <= Cible, "#1FA64A", 
			    "#D94B5A"
			)
			```
		displayFolder: Restitution
		lineageTag: 0ac3ba76-f49c-45f8-9d28-ca8f026cee93

	/// Sert à afficher un texte, une couleur ou un contenu de restitution dans le rapport. La comparaison se fait avec la même période de l'année précédente.
	measure 'Narratif HTML' = ```
			
			VAR Periode = MAX(DateTable[Periode])
			VAR CA = FORMAT([Quittancement], "#,##0 €")
			VAR Logements = FORMAT([Nombre de logements], "#,##0")
