	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Vacance phy commerciale commerces' = CALCULATE(DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]), 'Nature UG'[code_nature_ug] in {"COM"}, PatrimoineSrhEnGestionDepuis2023[code_etat_ug] in {"MEL", "VO", "VR", "VRD"})
