	measure 'Quittancement hors AL (mois précédent)' = ```
			
			VAR MoisCourant = MAX(DateTable[Date])
			VAR MoisPrecedent = EOMONTH(MoisCourant, -1)
			VAR PeriodeMoin1 = FORMAT(MoisPrecedent, "YYYY-MM")
			RETURN
			CALCULATE(
			    SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitALm_ca_operation]),
			    FILTER(
			        ALL(DateTable),
			        DateTable[Periode] = PeriodeMoin1
