			      IndicateursFinanciersShrEnGestionDepuis2023[txrecouvhppm_ca_operation]+0=0,0, IndicateursFinanciersShrEnGestionDepuis2023[txrecouvhppm_ca_operation]*IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]+0
			      )
			    )
			  ),
			  sumx(IndicateursFinanciersShrEnGestionDepuis2023,IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]),0)
			  
			  
			  
			 
