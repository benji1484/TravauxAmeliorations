	/// Compte les entrées, sorties ou mouvements des locataires.
	measure Mutation = CALCULATE(DISTINCTCOUNT(LocatairesShrEnGestionDepuis2023[code_ca]), LocatairesShrEnGestionDepuis2023[ind_mutation]="O")
		formatString: 0
		displayFolder: Occupation et mobilité
		lineageTag: a792df60-5285-44c0-ae6a-d946ff20041a

	/// Compte les entrées, sorties ou mouvements des locataires. Le résultat est cumulé depuis le début de l'année.
	measure 'Mutations cumul annuel' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(LocatairesShrEnGestionDepuis2023[code_ca]),
			    FILTER(
			        ALLEXCEPT(LocatairesShrEnGestionDepuis2023,  
					 'UG - Lib Patrimoine'[lbl_patrimoine_ptm], TranchAge[Tranche d'âge], MapTerritoire[Territoire],LocatairesShrEnGestionDepuis2023[batiment], MapTerritoire[xAgence], 'Nature UG'[GroupeNature], 'UG - Lib Patrimoine'[code_HP1], 'UG - Lib Patrimoine'[Patrimoine]), 
			        LEFT(LocatairesShrEnGestionDepuis2023[periode], 4) = LEFT(MAX(LocatairesShrEnGestionDepuis2023[periode]), 4) &&
			        LocatairesShrEnGestionDepuis2023[periode] <= MAX(LocatairesShrEnGestionDepuis2023[periode]) && LocatairesShrEnGestionDepuis2023[ind_mutation] = "O"
			    )
			)
			```
		formatString: 0
		displayFolder: Occupation et mobilité
		lineageTag: f4237ffe-ec9a-48a8-9bc6-48f3e943a4a6

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure 'Tx Mutation' = [Mutation] / [Nombre d'entrées]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: À vérifier
		lineageTag: 8f8a24f7-b12d-461c-89a9-eee0bb88058b

	/// Mesure la part ou le rythme des mouvements d'occupation. Le résultat est cumulé depuis le début de l'année.
	measure 'Taux de mutation cumul annuel' = ```
			[Mutations cumulées annuelles] / [Entrées cumulées annuelles historiques]   
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Occupation et mobilité
		lineageTag: ef1c006b-3494-48fa-bd19-384f2435a1d9

	/// Suit la couverture assurantielle des locataires ou des logements.
	measure 'Taux d''assurés' = [Nombre d'assurés] / [Nombre de logements et commerces contractés]
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Assurances
		lineageTag: df1a8979-ff85-4e7b-942b-0ee148db2900

	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Nombre de contrats principaux' = CALCULATE(DISTINCTCOUNT(LocatairesShrEnGestionDepuis2023[code_ca]), LocatairesShrEnGestionDepuis2023[contractant_principal] = "O", LocatairesShrEnGestionDepuis2023[statut_caug] = "Present", LocatairesShrEnGestionDepuis2023[code_nature_ug] in {"LGH","LGT"}, LocatairesShrEnGestionDepuis2023[statut_catiep] = "Present")
		formatString: 0
		displayFolder: Patrimoine
		lineageTag: 07793f91-d87f-47bd-a043-afa3c7bd1bd4

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure '# Logements contractés' = CALCULATE(DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]), 'Nature UG'[code_nature_ug] in {"LGT","LGH"}, PatrimoineSrhEnGestionDepuis2023[code_etat_ug] = "CTT")
		formatString: 0
		displayFolder: À vérifier
		lineageTag: 8c3c35a7-e2da-4ac9-91f3-6559c31bb768

	/// Suit la couverture assurantielle des locataires ou des logements.
	measure 'Nombre d''assurés' = CALCULATE(DISTINCTCOUNT(LocatairesShrEnGestionDepuis2023[code_ca]), LocatairesShrEnGestionDepuis2023[statut_caug] = "Present", LocatairesShrEnGestionDepuis2023[ind_assurance] = "O")
		formatString: 0
		displayFolder: Assurances
		lineageTag: 420de848-1b63-4f82-9307-52b6bd842325

	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Nombre de logements vacants en commercial' = ```
			CALCULATE([Nombre d'UG], PatrimoineSrhEnGestionDepuis2023[code_etat_ug] in {"VO", "MEL", "VRD", "VR"}, 'Nature UG'[code_nature_ug] in {"LGT", "LGH"}) 
