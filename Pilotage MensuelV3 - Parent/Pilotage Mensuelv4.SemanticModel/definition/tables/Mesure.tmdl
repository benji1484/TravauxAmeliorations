	/// Suit un indicateur descriptif du patrimoine.
	measure 'Prix mensuel²' = sum(PatrimoineSrhEnGestionDepuis2023[LoyerThéo_HT]) / sum(PatrimoineSrhEnGestionDepuis2023[SurfaceHabitable])
		displayFolder: Patrimoine
