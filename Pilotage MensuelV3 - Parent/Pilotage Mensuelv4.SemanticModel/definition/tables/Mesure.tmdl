	measure 'Vacance Stratégique logement' = CALCULATE(DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]), 'Nature UG'[code_nature_ug] in {"LGT","LGH"}, PatrimoineSrhEnGestionDepuis2023[code_etat_ug] in {"VVO", "VEN", "VDE"})
