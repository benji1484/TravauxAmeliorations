	/// Additionne les montants facturés, encaissés ou liés aux allocations.
	measure Quittancement = sum(IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
