	/// Indique une proportion liée aux impayés ou à l'évolution de la dette.
	measure 'Taux de croissance mensuelle de la dette' = DIVIDE([Dette hors passages en perte] - [Montant Dette mois précédent], [Montant Dette mois précédent])
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Dette et impayés
		lineageTag: 9279f779-00c2-42e4-bbf8-fc32e119b2eb

	/// Indique une proportion liée aux impayés ou à l'évolution de la dette. Le résultat est cumulé depuis le début de l'année.
	measure 'Taux de croissance annuelle de la dette' = ```
			
			VAR AnneeCourante = MAX(DateTable[Year])
			VAR DetteDecembreN1 =
			    CALCULATE (
			        [Dette],
			        REMOVEFILTERS ( DateTable ),
			        DateTable[Month Number] = 12,
			        DateTable[Year] = AnneeCourante - 1
			    )
			RETURN
			DIVIDE ( [Dette] - DetteDecembreN1 + [Passages en perte cumulés annuels], DetteDecembreN1 )
			
			```
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Dette et impayés
		lineageTag: a16063f2-1c1f-441b-99e3-ad2b4b7c468f

