	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure Quitm_ca_calculé = sum(IndicateursFinanciersShrEnGestionDepuis2023[loyerHCm_ca_operation])+sum(IndicateursFinanciersShrEnGestionDepuis2023[autresfactum_ca_operation]) + sum(IndicateursFinanciersShrEnGestionDepuis2023[chargesfactum_ca_operation])
