		lineageTag: 1771074c-7a26-467f-a4e8-fc1f1ca399d6

	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Nombre d''UG vacantes depuis plus de trois mois' = ```
			
			VAR UGVacants =
			    CALCULATETABLE(
			        VALUES(PatrimoineSrhEnGestionDepuis2023[code_ug]),
			
			        PatrimoineSrhEnGestionDepuis2023[code_etat_ug] <> "CTT",
			        'Nature UG'[code_nature_ug] IN {"LGT", "LGH"}
			    )
			VAR UGVacants_LongueDuree =
			    FILTER(
			        UGVacants,
			        CALCULATE(
			            SUM(PatrimoineSrhEnGestionDepuis2023[NBJoursVac]),
			            FILTER(
			                ALL(PatrimoineSrhEnGestionDepuis2023),
			                PatrimoineSrhEnGestionDepuis2023[code_ug] = EARLIER(PatrimoineSrhEnGestionDepuis2023[code_ug]) &&
			                LEFT(PatrimoineSrhEnGestionDepuis2023[periode], 4) = "2024" && LEFT(PatrimoineSrhEnGestionDepuis2023[periode], 4) = LEFT(MAX(PatrimoineSrhEnGestionDepuis2023[periode]), 4) &&
			        PatrimoineSrhEnGestionDepuis2023[periode] <= MAX(PatrimoineSrhEnGestionDepuis2023[periode])
			            )
			        ) > 90
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]),
			        PatrimoineSrhEnGestionDepuis2023[code_ug] IN UGVacants_LongueDuree
			    )
			
			```
		formatString: 0
		displayFolder: Vacance\Physique
		lineageTag: 390b9f3d-d548-4000-a485-db7da34e9c70

	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
