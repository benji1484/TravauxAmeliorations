	/// Compte des éléments du patrimoine comme les logements, commerces, bâtiments ou unités de gestion.
	measure 'Taux Commerces' = ```
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]),
			        'Nature UG'[code_nature_ug] IN {"COM"}
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(PatrimoineSrhEnGestionDepuis2023[code_ug]),
			        ALLEXCEPT(
			            PatrimoineSrhEnGestionDepuis2023,
			            PatrimoineSrhEnGestionDepuis2023[periode], 
			            PatrimoineSrhEnGestionDepuis2023[code_ho2], 
			            PatrimoineSrhEnGestionDepuis2023[code_ug]
			        ),
			        'Nature UG'[code_nature_ug] IN {"COM"}
			    )
			)
			
			```
		displayFolder: Patrimoine
		lineageTag: adde08f2-63eb-4f6b-9685-c1ebb0c9e638

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Indique la part de vacance par rapport au volume de référence, pour suivre le niveau de vacance.
	measure 'Taux de vacance commerciale des commerces' = CALCULATE([Taux Commerces], Type_vacance[type_vacance] = "Vacance commerciale")
		formatString: 0.00\ %;-0.00\ %;0.00\ %
