	/// Compte les logements, commerces ou unités concernés par une situation de vacance.
	measure 'Vacance phy globale commerce' = ```
			calculate(
			
			    distinctcount(PatrimoineSrhEnGestionDepuis2023[code_ug]), PatrimoineSrhEnGestionDepuis2023[code_etat_ug] <> "CTT", PatrimoineSrhEnGestionDepuis2023[code_nature_ug] in {"COM"}
			) 
