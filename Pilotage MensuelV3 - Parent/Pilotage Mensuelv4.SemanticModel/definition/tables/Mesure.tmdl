	/// Additionne les montants facturés, encaissés ou liés aux allocations. La comparaison se fait avec le mois précédent.
	measure 'Quittancement mois précédent Débiteurs' = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriod, 4))
			VAR CurrentMonth = VALUE(RIGHT(CurrentPeriod, 2))
			
			VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)
			VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)
			
			VAR PrevPeriod = FORMAT(PrevYear, "0000") & "-" & FORMAT(PrevMonth, "00")
			
			RETURN
			CALCULATE(
			    SUMX(
			        IndicateursFinanciersShrEnGestionDepuis2023,
			        IF(
			            IndicateursFinanciersShrEnGestionDepuis2023[soldem1_ca_operation] > 0,
			            IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation],
			            0
			        )
			    ),
			    PeriodeCal[période] = PrevPeriod
			)
			
			```
		displayFolder: Encaissement et quittancement
		lineageTag: 9eb92183-42ae-4e4b-94d2-0655068df513

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Additionne les montants facturés, encaissés ou liés aux allocations. La comparaison se fait avec le mois précédent.
	measure 'Quittancement mois précédent Crediteurs' = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriod, 4))
			VAR CurrentMonth = VALUE(RIGHT(CurrentPeriod, 2))
			VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)
			VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)
			VAR PrevPeriod = FORMAT(PrevYear, "0000") & "-" & FORMAT(PrevMonth, "00")
			
			RETURN
			CALCULATE(
			    SUMX(
			        IndicateursFinanciersShrEnGestionDepuis2023,
			        IF(
			            IndicateursFinanciersShrEnGestionDepuis2023[soldem1_ca_operation] < 0,
