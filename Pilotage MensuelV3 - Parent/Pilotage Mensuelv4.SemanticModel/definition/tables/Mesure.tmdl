	measure 'Dates données GL' = ```
			
			VAR DateMax = MAX(PeriodeCal[DateCible])
			VAR MoisAnneeDateMax = FORMAT(DateMax, "YYYY-MM")
			VAR MoisAnneeAujourdhui = FORMAT(TODAY(), "YYYY-MM")
			VAR DifferenceJours = DATEDIFF(DateMax, TODAY(), DAY)
			
			RETURN 
			    IF(
			        MoisAnneeDateMax = MoisAnneeAujourdhui && DifferenceJours > 1,
			        "Problème de chargement",  
			        DateMax
			    )
			
			```
