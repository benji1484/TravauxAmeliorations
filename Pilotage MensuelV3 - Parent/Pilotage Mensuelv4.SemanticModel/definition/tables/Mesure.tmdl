		lineageTag: 36c12aa3-dbbe-41c6-b76e-ee91e25cad99

	/// Indique une proportion liée aux impayés ou à l'évolution de la dette.
	measure 'Dette positive avec passages en perte' = ```
			SUMX(
			    IndicateursFinanciersShrEnGestionDepuis2023,
			    IF('IndicateursFinanciersShrEnGestionDepuis2023'[soldem_ca_operation] > 0, 'IndicateursFinanciersShrEnGestionDepuis2023'[soldem_ca_operation], 0)
			) 
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Dette et impayés
		lineageTag: d64556f0-d7d8-4b48-9e29-89ff95e83240

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure 'Tx Encaissement HPP Soldes_CA_Operation N-1' = ```
			
			VAR PrevYear = VALUE(LEFT(MAX(PeriodeCal[période]), 4)) - 1
			VAR CurrentMonth = VALUE(RIGHT(MAX(PeriodeCal[période]), 2))
			VAR PrevPeriod = FORMAT(PrevYear, "0000") & "-" & FORMAT(CurrentMonth, "00")
			
			RETURN
			1 - 
			    DIVIDE(
			        CALCULATE(
			            [Variation mensuelle de la dette historique],
			            FILTER(
			                ALL(PeriodeCal),
			                PeriodeCal[période] = PrevPeriod
			            )
			        ),
			        CALCULATE(
			            [Quittancement mensuel],
			            FILTER(
			                ALL(PeriodeCal),
			                PeriodeCal[période] = PrevPeriod
			            )
			        ),
			        0 -- Renvoie 0 en cas de division par zéro
			    )
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: À vérifier
		lineageTag: dc1bd43a-c9c7-4516-b1f8-65c5cbf2107b

	/// Suit la part des sommes encaissées par rapport aux sommes attendues. La comparaison se fait avec la même période de l'année précédente.
	measure 'Taux Encaissement cumul annuel année précédente' = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR PrevPeriod =
			    FORMAT(VALUE(LEFT(CurrentPeriod, 4)-1), "0000") & "-" &
			    FORMAT(VALUE(RIGHT(CurrentPeriod, 2)), "00")
			
			VAR CroissanceSoldemN1 =
			    CALCULATE(
			        [Variation de dette cumulée annuelle],
			        TREATAS({ PrevPeriod }, PeriodeCal[période])
			    )
			
			VAR CumulQuitmN1 =
			    CALCULATE(
			        [Quittancement cumulé annuel historique],
			        TREATAS({ PrevPeriod }, PeriodeCal[période])
			    )
			
			RETURN
			1 - DIVIDE(CroissanceSoldemN1, CumulQuitmN1, 0)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Encaissement et quittancement
		lineageTag: 11b4bc86-b269-4a45-a937-dd120827e0bb

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure 'CroissanceSoldem_CA_Operation_YTD N-1' = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriod, 4))
			VAR CurrentMonth = VALUE(RIGHT(CurrentPeriod, 2))
			
			VAR PrevYear = CurrentYear - 1
			VAR PrevPeriod = FORMAT(PrevYear, "0000") & "-" & FORMAT(CurrentMonth, "00")
			
			RETURN
			CALCULATE(
			    [Variation de dette cumulée annuelle],
			    TREATAS({ PrevPeriod }, PeriodeCal[période])
			)
			
			```
		displayFolder: À vérifier
		lineageTag: a455098d-852d-4ade-8943-d330768d8b2b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// À vérifier avant usage. Cette mesure n'a pas été retrouvée dans les rapports analysés et doit être confirmée avec le métier. Elle est conservée temporairement pour éviter de supprimer un calcul potentiellement utile.
	measure croissance_soldem_ca_operation_+ = ([Dette positive hors passages en perte] - [Dette positive du mois précédent])
