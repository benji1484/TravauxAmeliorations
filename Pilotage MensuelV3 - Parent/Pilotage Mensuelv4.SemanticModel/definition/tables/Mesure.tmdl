	/// Compte les logements, commerces ou unités concernés par une situation de vacance. La comparaison se fait avec la même période de l'année précédente.
	measure 'Vacance Financière cumul annuel année précédente' = ```
			
			CALCULATE(
			    SUM(IndicateursVacanceShrEnGestionDepuis2023[TotalVacanceYTD_ug]),
			    FILTER(
			        ALL('PeriodeCal'),
			        PeriodeCal[période] = FORMAT(VALUE(LEFT(MAX(PeriodeCal[période]), 4)) - 1, "0000") & "-" & RIGHT(MAX(PeriodeCal[Période]), 2)
			    )
			)
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
