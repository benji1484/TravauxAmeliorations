	partition PeriodeCal-6aff0217-0f73-4b0d-8ff6-ef0f8adac5b4 = calculated
		mode: import
		source = ```
				
				VAR StartDate = DATE(2022, 1, 1)
				VAR EndDate = EOMONTH(TODAY(), 0)
				VAR MoisActuel = FORMAT(TODAY(), "YYYY-MM")
				VAR MonthsTable =
				    GENERATE(
				        CALENDAR(StartDate, EndDate),
				        VAR CurrentMonthStart = EOMONTH([Date], -1) + 1
				        VAR CurrentPeriode = FORMAT(CurrentMonthStart, "YYYY-MM")
				        VAR DateCible =
				            IF(
				                CurrentPeriode = MoisActuel,
				                TODAY() - 1,
				                EOMONTH([Date], 0)
				            )
				        RETURN ROW(
				            "MoisAnnée", CurrentPeriode,
				            "Année", YEAR(CurrentMonthStart),
				            "DateCible", DateCible,
				            "EstMoisActuel", CurrentPeriode = MoisActuel
				        )
				    )
				RETURN
				    DISTINCT(
				        SELECTCOLUMNS(
				            MonthsTable,
				            "Période", [MoisAnnée],
				            "Année", [Année],
				            "DateCible", [DateCible],
				            "EstMoisActuel", [EstMoisActuel]
				        )
				    )
				
				
				```

	annotation PBI_Id = bf179482f2b24322a4d282db5ee588a0

