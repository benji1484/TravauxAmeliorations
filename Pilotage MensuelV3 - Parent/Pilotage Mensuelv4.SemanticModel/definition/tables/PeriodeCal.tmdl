	column finAnneeDerniereEtMoisMoin1 = ```
			
			VAR AnneeActuelle = YEAR(TODAY())
			VAR MoisMax =
			    CALCULATE(
			        MAX(PeriodeCal[Période]),
			        ALL(PeriodeCal)
			    )
			VAR MoisMoin1 =
			    CALCULATE(
			        MAX(PeriodeCal[Période]),
			        FILTER(
			            ALL(PeriodeCal),
			            PeriodeCal[Période] < MoisMax
			        )
			    )
			VAR FinAnneeDerniere = (AnneeActuelle - 1) & "-12"
			RETURN
			IF(
			    PeriodeCal[Période] = FinAnneeDerniere || PeriodeCal[Période] = MoisMoin1,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 13593e76-7f63-47ac-9c94-4b7514ee5522
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column moisActuelle = ```
			
			VAR MaxPeriode =
			    CALCULATE(
			        MAX(PeriodeCal[Période]),
			        ALL(PeriodeCal)
			    )
			VAR MoisPrecedent =
			    CALCULATE(
			        MAX(PeriodeCal[Période]),
			        FILTER(
			            ALL(PeriodeCal),
			            PeriodeCal[Période] < MaxPeriode
			        )
			    )
			RETURN
			IF(PeriodeCal[Période] = MoisPrecedent, 1, 0)
			
			```
		formatString: 0
		lineageTag: 6f9927e4-8344-420e-8723-4e8890173092
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column AnneeActuelle =
			
			VAR AnneeActuel = max(PeriodeCal[Année])
			
			RETURN
			IF(PeriodeCal[Année] = AnneeActuel, 1, 0)
		formatString: 0
		lineageTag: 6ddf8246-1687-4225-a2a1-eb218e23d147
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DerniersTroisMois = ```
			
			VAR MoisActuel = MAX(PeriodeCal[Période]) -- Période maximale (exemple : "2024-11")
			VAR TroisDerniersMois =
			    ADDCOLUMNS(
			        GENERATESERIES(-3, 0, 1), -- Les trois derniers mois
			        "Période", FORMAT(EDATE(MoisActuel, [Value]), "yyyy-MM")
			    )-- je décale d'encore 1 mois pour prendre ne compte la nouvelle règle de calcul (estmoisactuel true / false)
			RETURN
			IF(
			    PeriodeCal[Période] IN SELECTCOLUMNS(TroisDerniersMois, "Période", [Période]),
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 3969c924-6079-4249-a1b6-3bdb86582057
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DerniersTreizeMois = ```
			
			VAR MoisActuel = MAXX(PeriodeCal, PeriodeCal[Période]) -- Période maximale au format "YYYY-MM"
			VAR MoisActuelDate = DATE(LEFT(MoisActuel, 4), RIGHT(MoisActuel, 2), 1) -- Conversion en date
			VAR MoisDebutDate = EOMONTH(MoisActuelDate, -14) + 1 -- Premier jour du mois il y a 12 mois
			-- je décale d'encore 1 mois pour prendre ne compte la nouvelle règle de calcul (estmoisactuel true / false)
			RETURN 
			IF(
			    PeriodeCal[Période] >= FORMAT(MoisDebutDate, "YYYY-MM") &&
			    PeriodeCal[Période] <= FORMAT(MoisActuelDate, "YYYY-MM"),
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 235b32bd-6eaa-4489-9c7d-63ea4fa22c07
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

