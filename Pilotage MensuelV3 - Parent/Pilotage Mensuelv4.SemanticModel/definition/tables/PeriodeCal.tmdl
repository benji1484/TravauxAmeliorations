	column DerniersDeuxMois = ```
			
			VAR MoisActuel = MAX(PeriodeCal[Période]) -- Période maximale (exemple : "2024-11")
			VAR TroisDerniersMois =
			    ADDCOLUMNS(
			        GENERATESERIES(-2, 0, 1), -- Les trois derniers mois
			        "Période", FORMAT(EDATE(MoisActuel, [Value]), "yyyy-MM")
			    )-- je décale d'encore 1 mois pour prendre ne compte la nouvelle règle de calcul (estmoisactuel true / false)
			RETURN
			IF(
			    PeriodeCal[Période] IN SELECTCOLUMNS(TroisDerniersMois, "Période", [Période]),
			    1,
			    0
			)
			
			```
