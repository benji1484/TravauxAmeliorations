	measure '€ Croissance annuelle Dette' = ```
			
			VAR AnneeCourrante = Max(DateTable[Year]) 
			VAR DetteDecembreN1 = CALCULATE([€ Dette],REMOVEFILTERS(DateTable), DateTable[Month Number] = 12, DateTable[Year] = AnneeCourrante-1)
			RETURN
			[€ Dette] - DetteDecembreN1 + [€ PP YTD]
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: f842b283-3fb7-4a97-aa5e-60c901dd2189

	measure 'Taux Encaissement YTD' = ```
			
			([€ Quittancement YTD] - [€ Croissance annuelle Dette])
			    / [€ Quittancement YTD]
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Dimension Temps
		lineageTag: 03a05e78-3c19-48df-91a4-bc171599f197

	measure '€ Dette M1' = CALCULATE([€ Dette HPP], PREVIOUSMONTH(DateTable[Date]))
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 1601edf8-b48e-4fd0-8af7-9b2e00820afd

	measure '€ Croissance Dette' = ```
			
			VAR CurrentDate = MAX ( DateTable[Date] ) -- date courante du contexte
			VAR PreviousDate =
			    EOMONTH ( CurrentDate, -1 ) -- fin du mois précédent
			VAR IsJanuary = MONTH ( CurrentDate ) = 1
			VAR CumulPrevious =
			    CALCULATE (
			        [€ PP YTD],
			        DateTable[Date] = PreviousDate
			    )
			RETURN
			    IF (
			        IsJanuary,
			        ( [€ Dette HPP] - [€ Dette M1] ) + CumulPrevious,
			        ( [€ Dette HPP] - [€ Dette M1] )
			    )
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 2050313a-3eda-42a5-aa2e-0d5812c1d8e6

	measure '% Taux Encaissement Mensuel' = ```
			
			([€ Quittancement] - [€ Croissance Dette])
			    / [€ Quittancement]
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
