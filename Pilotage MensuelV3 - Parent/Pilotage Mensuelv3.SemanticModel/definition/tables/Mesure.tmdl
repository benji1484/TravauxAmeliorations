	measure Soldem1_ca_operation_+ = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriod, 4))
			VAR CurrentMonth = VALUE(RIGHT(CurrentPeriod, 2))
			
			VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)
			VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)
			
			VAR PrevPeriod = FORMAT(PrevYear, "0000") & "-" & FORMAT(PrevMonth, "00")
			
			RETURN
			CALCULATE(
			    SUMX(
			        IndicateursFinanciersShrEnGestionDepuis2023,
			        IF(
			            'IndicateursFinanciersShrEnGestionDepuis2023'[soldem_ca_operation] > 0, 
			            'IndicateursFinanciersShrEnGestionDepuis2023'[soldem_ca_operation], 
			            0
			        )
			    ) + [CumulPassagesEnPerteAnnuel],
			    
			    PeriodeCal[période] = PrevPeriod
			)
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 684d732c-097e-4d21-84dc-4782af8f2efc

	measure 'Soldem_ca_operation_+ hpp' =
			SUMX(
			    IndicateursFinanciersShrEnGestionDepuis2023,
			    IF('IndicateursFinanciersShrEnGestionDepuis2023'[soldem_ca_operation] > 0, 'IndicateursFinanciersShrEnGestionDepuis2023'[soldem_ca_operation], 0)
			) + [CumulPassagesEnPerteAnnuel]
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 86fab590-df97-4290-856d-0a0fdb9da6d5

	measure '% croissance_soldem_ca_operation_+' = ([Soldem_ca_operation_+ hpp] - [Soldem1_ca_operation_+]) / ([Soldem1_ca_operation_+])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3db2d575-7b24-4a94-b3f1-e2548388d3e7

	measure CumulPassagesEnPerteAnnuel = ```
			
			CALCULATE(
			    SUM(
			        IndicateursFinanciersShrEnGestionDepuis2023[passage_en_perte_CAm]
			    ),
			    FILTER(
			        ALLEXCEPT(IndicateursFinanciersShrEnGestionDepuis2023, 
			        IndicateursFinanciersShrEnGestionDepuis2023[code_type_ca], 
			        TranchAge[Tranche d'âge],IndicateursFinanciersShrEnGestionDepuis2023[statut_caug], 
			        'UG - Lib Patrimoine'[code_HP1], 
			        'UG - Lib Patrimoine'[lbl_commune], 
			        'UG - Lib Patrimoine'[lbl_patrimoine_ptm], 
			        IndicateursFinanciersShrEnGestionDepuis2023[batiment], 
			        IndicateursFinanciersShrEnGestionDepuis2023[dimension_ca], 
			        code_type_ca[Type_Locataire], 
			        IndicateursFinanciersShrEnGestionDepuis2023[code_ho2],
			        MapTerritoire[Code_ho2], 
			        MapTerritoire[Territoire], 
			        MapTerritoire[xAgence], 
			        IndicateursFinanciersShrEnGestionDepuis2023[code_ca], 
			        IndicateursFinanciersShrEnGestionDepuis2023[code_hp1])
			        ,
			
			        IndicateursFinanciersShrEnGestionDepuis2023[periode] <= MAX(IndicateursFinanciersShrEnGestionDepuis2023[periode]) &&
			        LEFT(IndicateursFinanciersShrEnGestionDepuis2023[periode], 4) = LEFT(MAX(IndicateursFinanciersShrEnGestionDepuis2023[periode]), 4) &&
			        IndicateursFinanciersShrEnGestionDepuis2023[passage_en_perte_CAm] > 0
			    )
			)
			
			```
		lineageTag: b81f5311-4cb2-4f20-a5d9-096f089570f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PPM1 = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR CurrentYear = VALUE(LEFT(CurrentPeriod, 4))
			VAR CurrentMonth = VALUE(RIGHT(CurrentPeriod, 2))
			
			VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)
			VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)
			
			VAR PrevPeriod = FORMAT(PrevYear, "0000") & "-" & FORMAT(PrevMonth, "00")
			
			RETURN
			IF(
			    CurrentMonth = 1, 
			    0, -- Retourne 0 si le mois est janvier
			    CALCULATE(
			        [CumulPassagesEnPerteAnnuel],
			        PeriodeCal[période] = PrevPeriod
			    )
			)
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: b0804143-869d-45ac-8d15-d72b43a86ca9

	measure '€ Croissance soldem_ca_operation' = ```
			
			VAR CurrentPeriod = SELECTEDVALUE(PeriodeCal[période]) -- Période actuelle
			VAR PreviousPeriod = 
			    FORMAT(
			        DATE(YEAR(DATEVALUE(CurrentPeriod)), MONTH(DATEVALUE(CurrentPeriod)), 1) - 1, 
			        "yyyy-mm"
			    ) -- Calcul de la période précédente
			VAR IsJanuary = RIGHT(CurrentPeriod, 2) = "01" -- Vérifie si le mois est janvier
			VAR CumulPrevious = 
			    CALCULATE(
			        [CumulPassagesEnPerteAnnuel],
			        PeriodeCal[période] = PreviousPeriod
			    ) -- Calcul de la mesure sur la période précédente
			RETURN
			    IF (
			        IsJanuary,
			        ([Soldem_ca_operation_+ hpp] - [Soldem1_ca_operation_+]) + CumulPrevious,
			        ([Soldem_ca_operation_+ hpp] - [Soldem1_ca_operation_+])
			    )
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: a063cda7-a73c-4461-adb0-ec0fb3a8b46c

	measure '€ Quitm_ca_operation' = SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 8b7a7277-27e3-4901-8682-679d64e31f0c

	measure 'Tx Encaissement hpp soldes_ca_operation' = 1 - [€ Croissance soldem_ca_operation] / [€ Quitm_ca_operation]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 4bd10b43-e4c9-4f2d-a19a-2a7510940abb

	measure CroissanceSoldem_CA_Operation_YTD = ```
			
			VAR MoisDecembre = 
			    CALCULATE(
			       SUMX(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            IF(
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation] > 0,
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation], 
			                0
			            )
			        ),
			        TREATAS( 
			            { MAX(PeriodeCal[Année])-1 & "-12" }, 
			            PeriodeCal[Période]
			        )
			    )
			RETURN 
			    CALCULATE(
			        SUMX(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            IF(
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation] > 0,
			                IndicateursFinanciersShrEnGestionDepuis2023[soldem_ca_operation], 
			                0
			            )
			        ),
			        FILTER(
			            IndicateursFinanciersShrEnGestionDepuis2023,
			            LEFT(IndicateursFinanciersShrEnGestionDepuis2023[periode], 4) = format(Max(PeriodeCal[Année]), "0000")
			        ),
			        TREATAS(
			            VALUES(PeriodeCal[Période]), 
			            IndicateursFinanciersShrEnGestionDepuis2023[periode]
			        )
			    ) + [CumulPassagesEnPerteAnnuel] - MoisDecembre
			
			```
		lineageTag: e4015199-5598-40a6-a86d-27d5ebbd4056

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CumulQuitm_CA_Operation_YTD =
			
			CALCULATE(SUM(IndicateursFinanciersShrEnGestionDepuis2023[quitYTDm_ca_operation]), ALL(IndicateursFinanciersShrEnGestionDepuis2023[code_ca]))
