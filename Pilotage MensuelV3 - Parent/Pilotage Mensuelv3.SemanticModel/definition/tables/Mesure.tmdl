	measure Découpage1 = ```
			
			VAR CurrentPeriod = MAX(PeriodeCal[période])
			VAR PrevPeriod =
			    FORMAT(VALUE(LEFT(CurrentPeriod, 4)-1), "0000") & "-" &
			    FORMAT(VALUE(RIGHT(CurrentPeriod, 2)), "00")
			
			VAR CroissanceSoldemN1 =
			    CALCULATE(
			        [CroissanceSoldem_CA_Operation_YTD],
			        TREATAS({ PrevPeriod }, PeriodeCal[période])
			    )
			
			VAR CumulQuitmN1 =
			    CALCULATE(
			        [CumulQuitm_CA_Operation_YTD],
			        TREATAS({ PrevPeriod }, PeriodeCal[période])
			    )
			
			RETURN
			CroissanceSoldemN1
			
			```
		lineageTag: 49ddf01c-ddfa-438c-b261-dd99c63329dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

