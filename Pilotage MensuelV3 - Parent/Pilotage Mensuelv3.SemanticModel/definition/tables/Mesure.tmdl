	measure 'Couleur salariés' = ```
			
			VAR ValeurActuelle = [% Entrées Salariés YTD]
			VAR Cible = [Cible entrées salariés]
			
			RETURN
			SWITCH(
			    TRUE(),
			    ValeurActuelle < Cible, "#D94B5A",     
			    ValeurActuelle >= Cible, "#1FA64A", 
			    "#D94B5A"
			)
			```
		lineageTag: 3d40920e-8d27-486a-aa3f-c61dd3e4d7f6

	measure 'Couleur vacance' = ```
			
			VAR ValeurActuelle = [Vacance Financière Logements YTD]
			VAR Cible = sum(Obj_2024[Obj_TotalVacanceYTDm_Logements])
			
			RETURN
			SWITCH(
			    TRUE(),
			    ValeurActuelle > Cible, "#D94B5A",     
			    ValeurActuelle <= Cible, "#1FA64A", 
			    "#D94B5A"
			)
			```
		lineageTag: f0cb4da2-0f22-44aa-b44a-41e6c97d1038

	measure 'Couleur dette' = ```
			
			VAR ValeurActuelle = [€ Croissance annuelle Dette]
			VAR Cible = sum(Obj_2024[Obj_Variation_soldeYTDm_ca_operation_Locataires])
			
			RETURN
			SWITCH(
			    TRUE(),
			    ValeurActuelle > Cible, "#D94B5A",     
			    ValeurActuelle <= Cible, "#1FA64A", 
			    "#D94B5A"
			)
			```
		lineageTag: 0ac3ba76-f49c-45f8-9d28-ca8f026cee93

	measure 'Narratif HTML' = ```
			
			VAR Periode = MAX(DateTable[Periode])
			VAR CA = FORMAT([€ Quittancement], "#,##0 €")
			VAR Logements = FORMAT([# Logements], "#,##0")
			VAR Commerces = FORMAT([# Commerces], "#,##0")
			RETURN
			"
			<div style='
			height:105px;
			box-sizing:border-box;
			font-family:Segoe UI,Arial;
			background:white;
			border:1.5px solid #1d2ba3;
			border-radius:18px;
			color:#1a1a1a;
			overflow:hidden;
			display:flex;
			align-items:center;
			'>
			
			  <div style='
			  height:100%;
			  width:190px;
			  background:#1d2ba3;
			  color:white;
			  font-weight:800;
			  font-size:15px;
			  display:flex;
			  align-items:center;
			  justify-content:center;
			  border-top-right-radius:22px;
			  border-bottom-right-radius:22px;
			  '>
			    SYNTHÈSE<br>ACTIVITÉ
			  </div>
			
			  <div style='
			  flex:1;
			  padding:0 22px;
			  font-size:17px;
			  line-height:1.35;
			  '>
			    Sur la période 
			    <span style='background:#1d2ba3;color:white;font-weight:800;padding:2px 8px;border-radius:5px;'>" & Periode & "</span>,
			    la SHLMR a enregistré un CA de
			  </div>
			
			  <div style='
			  width:310px;
			  text-align:center;
			  font-size:34px;
			  font-weight:850;
			  color:#e91e63;
			  border-left:2px dotted #b8c0e8;
			  border-right:2px dotted #b8c0e8;
			  line-height:1;
			  '>
			    " & CA & "
			  </div>
			
			  <div style='
			  width:240px;
			  display:flex;
			  justify-content:space-around;
			  align-items:center;
			  font-size:12px;
			  background:#f5f6fb;
			  height:74px;
			  margin:0 12px;
			  border-radius:14px;
			  '>
			    <div style='text-align:center;'>
			      <div style='font-size:24px;font-weight:800;color:#1d2ba3;'>" & Logements & "</div>
			      logements
			    </div>
			    <div style='height:46px;border-left:1px solid #c9c9c9;'></div>
			    <div style='text-align:center;'>
			      <div style='font-size:24px;font-weight:800;color:#1d2ba3;'>" & Commerces & "</div>
			      commerces
			    </div>
			  </div>
			
			</div>
			"
			```
		lineageTag: 35ff9f48-72fb-49f9-8832-eb04ed6a69bf

