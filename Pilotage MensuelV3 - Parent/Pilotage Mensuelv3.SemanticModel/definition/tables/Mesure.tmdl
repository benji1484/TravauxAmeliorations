	measure 'Prix m²' = sum(PatrimoineSrhEnGestionDepuis2023[LoyerThéo_HT]) / sum(PatrimoineSrhEnGestionDepuis2023[SurfaceHabitable])
		lineageTag: ec5154ee-7f87-41b4-b750-323877031c2c

