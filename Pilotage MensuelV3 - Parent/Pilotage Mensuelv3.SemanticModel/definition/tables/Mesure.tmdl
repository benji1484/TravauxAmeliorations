	measure '% txrecouv M operation' =
			
			divide(
			  sumx(IndicateursFinanciersShrEnGestionDepuis2023,
			  if(
			    ISBLANK(IndicateursFinanciersShrEnGestionDepuis2023[txrecouvm_ca_operation]),0,
			    if(
			      IndicateursFinanciersShrEnGestionDepuis2023[txrecouvm_ca_operation]+0=0,0, IndicateursFinanciersShrEnGestionDepuis2023[txrecouvm_ca_operation]*IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]+0
			      )
			    )
			  ),
			  sumx(IndicateursFinanciersShrEnGestionDepuis2023,IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]),0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
