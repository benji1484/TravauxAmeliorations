	measure Age = ```
			
			VAR TableFiltree =
			    FILTER(
			        PatrimoineSrhEnGestionDepuis2023,
			        NOT(ISBLANK(PatrimoineSrhEnGestionDepuis2023[dte_ref])) &&
			        PatrimoineSrhEnGestionDepuis2023[Nature_CSP] = "Logement"
			    )
			VAR AgePondereSomme =
			    SUMX(
			        TableFiltree,
			        DATEDIFF(
			            PatrimoineSrhEnGestionDepuis2023[dte_ref],
			            TODAY(),
			            YEAR
			        ) * COUNTROWS(
			            VALUES(PatrimoineSrhEnGestionDepuis2023[code_ug])
			        )
			    )
			VAR TotalLogements =
			    SUMX(
			        TableFiltree,
			        COUNTROWS(
			            VALUES(PatrimoineSrhEnGestionDepuis2023[code_ug])
			        )
			    )
			RETURN
			IF(
			    TotalLogements > 0,
			    DIVIDE(AgePondereSomme, TotalLogements, BLANK()),
			    BLANK()
			)
			
			```
		lineageTag: fa400519-72e6-4532-b4de-c121c131514b

