	measure CumulQuittancementsAnnuel = ```
			
			CALCULATE(
			    SUM(
			        IndicateursFinanciersShrEnGestionDepuis2023[quitm_ca_operation]
			    ),
			    FILTER(
			        ALLEXCEPT(
			            IndicateursFinanciersShrEnGestionDepuis2023, 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_type_ca], 
			            IndicateursFinanciersShrEnGestionDepuis2023[statut_caug], 
			            IndicateursFinanciersShrEnGestionDepuis2023[dimension_ca], 
			            TranchAge[Tranche d'âge],
			            code_type_ca[Type_Locataire], 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_ho2], IndicateursFinanciersShrEnGestionDepuis2023[batiment],
			            MapTerritoire[Code_ho2], 
			            MapTerritoire[Territoire], 
			            MapTerritoire[xAgence], 
			            IndicateursFinanciersShrEnGestionDepuis2023[code_ca], IndicateursFinanciersShrEnGestionDepuis2023[code_nature_ug], 'Nature UG'[GroupeNature], UG_INSEE[code_ug], UG_INSEE[code_insee], 'UG - Lib Patrimoine'[lbl_patrimoine_ptm], 'UG - Lib Patrimoine'[code_HP1], IndicateursFinanciersShrEnGestionDepuis2023[code_hp1]
			        ),
			        IndicateursFinanciersShrEnGestionDepuis2023[periode] <= MAX(IndicateursFinanciersShrEnGestionDepuis2023[periode]) &&
			        LEFT(IndicateursFinanciersShrEnGestionDepuis2023[periode], 4) = LEFT(MAX(IndicateursFinanciersShrEnGestionDepuis2023[periode]), 4)
			    )
			)
			
			
