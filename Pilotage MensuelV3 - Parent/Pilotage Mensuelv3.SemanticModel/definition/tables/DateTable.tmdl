	column EstMoisValide =
			
			IF (
			    YEAR ( DateTable[Date] ) < YEAR ( TODAY() )
			        || ( YEAR ( DateTable[Date] ) = YEAR ( TODAY() )
			            && MONTH ( DateTable[Date] ) < MONTH ( TODAY() ) ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 28c9e2c4-ef0e-4c40-9127-4de7f3f50fd3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2020, 1, 1), today()), -- Adjust the date range as needed
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "Month Number", MONTH([Date]),
				    "MonthEnd", EOMONTH([Date], 0),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Weekday", FORMAT([Date], "dddd"),
				    "Weekday Number", WEEKDAY([Date], 2), -- 2 makes Monday = 1
				    "Periode", FORMAT([Date], "YYYY-MM"),
				    
				    "IsWeekend", IF(WEEKDAY([Date], 2) > 5, TRUE, FALSE)
				)
				
				```

	annotation PBI_Id = 36e41cdec5c641629ced60476473f1b9

